# Cloudflare Pages security headers — applies to every route.
# CSP allows 'unsafe-inline' for script-src/style-src because Astro emits
# small per-component <script>/style="..." blocks inline rather than as
# externally-hashed files; there's no server-side templating here to issue
# per-request nonces (the site is fully static). Tightening this further
# would require a build step that hashes each inline block into the policy.
# frame-src allows the Chatbase live-demo widget (LiveDemo.astro) — without
# it, default-src 'self' would silently block that iframe from loading.
# Permissions-Policy grants microphone to that same origin specifically
# (not a blanket allow) since the widget supports voice input.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(self "https://www.chatbase.co"), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; media-src 'self'; connect-src 'self'; frame-src https://www.chatbase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

# Astro's own build output — every file under /_astro/ has its content hash
# baked into the filename (e.g. Footer.BEJljECZ.css), so a changed file is a
# new URL, never a stale cache. Safe to cache for a full year as immutable.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Images and video in /public keep a fixed filename even when the file
# behind them is swapped out later, so these get a long-but-revalidating
# cache instead of the hashed assets' immutable one — a returning visitor
# gets the cached copy without a re-download, but a browser that still has
# it past max-age checks back with the origin rather than trusting a
# filename that could now point at different content.
/images/*
  Cache-Control: public, max-age=604800, must-revalidate

/videos/*
  Cache-Control: public, max-age=604800, must-revalidate
