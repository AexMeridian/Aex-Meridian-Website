# Required by functions/api/contact.js (the contact form's Cloudflare Pages
# Function). Get a key at https://resend.com and set it as a secret in the
# Cloudflare Pages dashboard (Settings -> Environment variables) — it is
# never read from a local .env file in production.
#
# Without this set, the contact form still works end-to-end but responds
# with a "not configured yet" message instead of sending an email.
RESEND_API_KEY=
