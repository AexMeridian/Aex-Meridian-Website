---
// Condensed founder presence for the homepage — a face and a direct line,
// not the full bio (that stays on How It Works, linked from here). Home
// previously had no person on it at all; this is deliberately small so it
// doesn't duplicate the fuller section, just proves one exists.
import fs from 'node:fs';
import path from 'node:path';
import { contactEmail, contactPhoneHref, contactPhoneDisplay } from '../data/site';

const founderPhotoExists = fs.existsSync(path.join(process.cwd(), 'public/images/founder.jpg'));
---

<section class="section founder-note seam">
  <div class="container founder-note-inner" data-reveal>
    <div class="founder-note-portrait">
      {founderPhotoExists ? (
        <img src="/images/founder.jpg" alt="Caleb Aex, founder of Aex Meridian" class="founder-note-photo" width="96" height="96" loading="lazy" />
      ) : (
        <div class="founder-note-monogram" role="img" aria-label="Caleb Aex, founder of Aex Meridian">AM</div>
      )}
    </div>

    <div class="founder-note-copy">
      <p class="founder-note-name">Caleb Aex, founder</p>
      <p class="founder-note-body">
        One person, start to finish. When you call, you get the person who actually
        builds your site — no account managers, no ticket queue. <a href="/how-it-works#founder">More about Caleb &rarr;</a>
      </p>
    </div>

    <div class="founder-note-contact">
      <a href={`mailto:${contactEmail}`} class="founder-note-link">{contactEmail}</a>
      <a href={contactPhoneHref} class="founder-note-link">{contactPhoneDisplay}</a>
    </div>
  </div>
</section>

<style>
  .founder-note {
    background: var(--color-white);
    color: var(--color-ink);
    padding: var(--space-5) 0;
  }

  .founder-note-inner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .founder-note-portrait {
    flex-shrink: 0;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid var(--color-teal);
  }

  .founder-note-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    display: block;
  }

  .founder-note-monogram {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 600;
    color: var(--color-ivory);
    background: linear-gradient(160deg, var(--color-navy) 0%, var(--color-teal) 140%);
  }

  .founder-note-copy {
    flex: 1;
    min-width: 0;
  }

  .founder-note-name {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    margin-bottom: 2px;
  }

  .founder-note-body {
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-ink-muted);
  }

  .founder-note-body a {
    color: var(--color-teal);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .founder-note-body a:hover,
  .founder-note-body a:focus-visible {
    color: var(--color-steel-on-light);
  }

  .founder-note-contact {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
  }

  .founder-note-link {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: var(--transition-fast);
  }

  .founder-note-link:hover,
  .founder-note-link:focus-visible {
    color: var(--color-teal);
    border-bottom-color: var(--color-teal);
  }

  @media (max-width: 760px) {
    .founder-note-inner {
      flex-wrap: wrap;
    }

    .founder-note-contact {
      align-items: flex-start;
      flex-direction: row;
      gap: var(--space-3);
      width: 100%;
      padding-left: calc(72px + var(--space-4));
    }
  }

  @media (max-width: 560px) {
    .founder-note-inner {
      text-align: center;
      justify-content: center;
    }

    .founder-note-portrait {
      margin: 0 auto;
    }

    .founder-note-contact {
      padding-left: 0;
      justify-content: center;
    }
  }
</style>
