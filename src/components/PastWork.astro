---
// Tabler outline icons (24x24, stroke-based) — hand-embedded since no icon
// library is installed in this project.
const categories = [
  {
    title: 'Trades and home services',
    body: 'Contractors, electricians, plumbers, and landscapers — showcase past work, service area, and a simple way to request a quote.',
    benefits: [
      'A gallery built to showcase past jobs',
      'Service-area and quote-request pages that cut down back-and-forth',
      'Best agent fit: AI Voice Receptionist — answers the phone when you\'re on a job',
    ],
    icon: '<path d="M11.414 10l-7.383 7.418a2.091 2.091 0 0 0 0 2.967a2.11 2.11 0 0 0 2.976 0l7.407 -7.385" /><path d="M18.121 15.293l2.586 -2.586a1 1 0 0 0 0 -1.414l-7.586 -7.586a1 1 0 0 0 -1.414 0l-2.586 2.586a1 1 0 0 0 0 1.414l7.586 7.586a1 1 0 0 0 1.414 0" />',
  },
  {
    title: 'Realtors, consultants and professional services',
    body: 'Realtors, property managers, Airbnb/VRBO hosts, coaches, and small practices — clear credentials or listings, and an easy way to get in touch. Realtors lean toward an AI Voice Receptionist for inbound calls; consultants and practices toward a Website Chat Agent for intake.',
    icon: '<path d="M3 9a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v9a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2l0 -9" /><path d="M8 7v-2a2 2 0 0 1 2 -2h4a2 2 0 0 1 2 2v2" /><path d="M12 12l0 .01" /><path d="M3 13a20 20 0 0 0 18 0" />',
  },
  {
    title: 'Local shops, retail and wellness',
    body: 'Boutiques, bakeries, florists, trainers, and stylists — hours, services, and location, always current, without a booking system to manage. Retail leans toward a Website Chat Agent for hours and stock questions; wellness businesses toward an AI Voice Receptionist for bookings and reminders.',
    icon: '<path d="M6.331 8h11.339a2 2 0 0 1 1.977 2.304l-1.255 8.152a3 3 0 0 1 -2.966 2.544h-6.852a3 3 0 0 1 -2.965 -2.544l-1.255 -8.152a2 2 0 0 1 1.977 -2.304" /><path d="M9 11v-5a3 3 0 0 1 6 0v5" />',
  },
];
---

<section class="section real-builds seam mode-dark-bleed" id="our-work">
  <div class="real-builds-texture" aria-hidden="true"></div>
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow">Who we serve</p>
      <h2 class="section-title">Built for businesses like these</h2>
      <p class="section-subtext">
        We specialize in local businesses that need a strong online presence, not a
        complicated system to manage.
      </p>
    </div>

    <div class="builds-grid" data-reveal>
      {categories.map((category, i) => (
        <div class:list={['build-card', i === 0 && 'build-card--lead']}>
          <span class="build-icon-badge">
            <span class="build-icon" set:html={`<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${category.icon}</svg>`} />
          </span>
          <h3 class="build-title">{category.title}</h3>
          <p class="build-body">{category.body}</p>
          {category.benefits && (
            <ul class="build-benefits">
              {category.benefits.map((item) => <li>{item}</li>)}
            </ul>
          )}
        </div>
      ))}
    </div>

    <div class="builds-fallback" data-reveal>
      <p class="builds-fallback-text">
        Don't see your type of business? These are the ones we see most, not the only
        ones we take on — <a href="/#contact">get in touch</a> and chances are we can help.
      </p>
      <p class="builds-link"><a href="/how-it-works">See who else we work with &rarr;</a></p>
    </div>
  </div>
</section>

<style>
  .real-builds {
    position: relative;
    overflow: hidden;
  }

  /* Local overrides win the light-section defaults set earlier in the
     global stylesheet (same specificity, later source order) — needed
     any time a section that used to be light flips to .mode-dark-bleed. */
  .real-builds .eyebrow {
    color: var(--color-steel);
  }

  .real-builds .section-title {
    color: var(--color-ivory);
  }

  /* Same aurora-mountains crop as the how-it-works hero — grounds this
     "who we serve" moment in a landscape rather than the starfield's
     space motif, at a low enough opacity to read as ambient texture,
     not a second photo. */
  .real-builds-texture {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: url('/images/textures/aurora-mountains.webp');
    background-size: cover;
    background-position: center;
    opacity: 0.13;
    pointer-events: none;
  }

  .real-builds .container {
    position: relative;
    z-index: 1;
  }

  .section-subtext {
    margin-top: var(--space-2);
    font-size: 17px;
    line-height: 1.7;
    color: var(--color-muted);
  }

  /* Asymmetric instead of three equal boxes — the first category (trades,
     the largest and most visual-heavy of the three) reads as the lead
     card, spanning both rows, with the other two stacked alongside it. */
  .builds-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: var(--space-3);
  }

  .build-card {
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-md);
    background: var(--color-navy-surface);
    padding: var(--space-5) var(--space-4);
    transition: var(--transition);
  }

  .build-card--lead {
    position: relative;
    grid-row: 1 / 3;
    display: flex;
    flex-direction: column;
    /* Was flex-end, packing icon/title/body against the bottom edge and
       leaving the top ~70% of this tall card as dead space under a ghost
       numeral too faint to read as "content." Anchoring to the top instead
       and pushing the added benefits list (margin-top: auto, below) down
       to the bottom edge fills the full height with real copy. */
    justify-content: flex-start;
    padding: var(--space-5) var(--space-4) var(--space-5);
    overflow: hidden;
  }

  /* The lead card is nearly twice the height of its two stacked siblings
     — without something to occupy that extra room, the icon/title/body
     block reads as bottom-anchored with a dead void above it. A large
     ghosted numeral (same device used on the How It Works profiles) fills
     the space with the site's own signature detail instead of empty air. */
  .build-card--lead::before {
    content: '01';
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    font-family: var(--font-display);
    font-size: 9rem;
    font-weight: 600;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px rgba(255, 255, 255, 0.1);
    pointer-events: none;
  }

  .build-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-steel);
    box-shadow: var(--shadow-tinted-dark);
  }

  .build-icon-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    background: rgba(61, 107, 107, 0.18);
    margin-bottom: var(--space-3);
    transition: var(--transition);
  }

  .build-card:hover .build-icon-badge {
    background: var(--color-teal);
  }

  .build-icon {
    display: inline-flex;
    color: var(--color-steel);
    transition: var(--transition);
  }

  .build-card:hover .build-icon {
    color: var(--color-ivory);
  }

  .build-title {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-ivory);
    margin-bottom: var(--space-2);
  }

  .build-card--lead .build-title {
    font-size: 24px;
  }

  .build-body {
    font-size: 16px;
    line-height: 1.65;
    color: var(--color-muted);
  }

  /* Only the lead card gets this (see the `benefits` field on the first
     category) — margin-top: auto pushes it to the card's bottom edge
     regardless of how tall the title/body above it end up being, so the
     card's full height reads as filled rather than leaving a gap either
     above or below. */
  .build-benefits {
    list-style: none;
    margin: auto 0 0;
    padding: 0;
    padding-top: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .build-benefits li {
    position: relative;
    padding-left: 20px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .build-benefits li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 9px;
    width: 8px;
    height: 1px;
    background: var(--color-steel);
  }

  /* A real callout, not a muted afterthought — the grid above reads as a
     definitive list of five categories right up until this box says
     otherwise, so it needs actual visual weight to correct that impression. */
  .builds-fallback {
    margin-top: var(--space-6);
    padding: var(--space-4) var(--space-5);
    text-align: center;
    background: rgba(61, 107, 107, 0.1);
    border: 1px solid rgba(107, 135, 168, 0.3);
    border-radius: var(--radius-md);
  }

  .builds-fallback-text {
    font-size: 17px;
    line-height: 1.6;
    font-weight: 500;
    color: var(--color-ivory);
    max-width: 56ch;
    margin: 0 auto;
  }

  .builds-fallback-text a {
    color: var(--color-steel);
    text-decoration: underline;
    text-underline-offset: 2px;
    font-weight: 600;
  }

  .builds-fallback-text a:hover,
  .builds-fallback-text a:focus-visible {
    color: var(--color-ivory);
  }

  .builds-link {
    margin-top: var(--space-3);
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .builds-link a {
    color: var(--color-steel);
    text-decoration: none;
    transition: var(--transition-fast);
  }

  .builds-link a:hover,
  .builds-link a:focus-visible {
    color: var(--color-ivory);
  }

  @media (max-width: 640px) {
    .builds-grid {
      grid-template-columns: 1fr;
      grid-template-rows: none;
    }

    .build-card--lead {
      grid-row: auto;
      padding: var(--space-5) var(--space-4);
    }
  }
</style>
