---
import { websitePlan, startingAgentSetup, startingAgentPrice } from '../data/pricing';
import MeridianRule from './MeridianRule.astro';
---

<section class="section final-cta seam cta-band" id="pricing">
  <video class="cta-band-video" data-src="/videos/cta-depth.mp4" muted playsinline loop preload="none" aria-hidden="true"></video>
  <div class="container cta-inner cta-band-inner" data-reveal>
    <MeridianRule dot="none" align="left" class="cta-rule" />
    <h2 class="cta-heading">Ready to see what we'd build for you?</h2>
    <p class="cta-price-label">One flat setup fee, no negotiation</p>
    <p class="cta-price-line">AI agents from {startingAgentSetup} setup + {startingAgentPrice}</p>
    <p class="cta-price-line cta-price-line-secondary">
      Website from {websitePlan.setup} setup + {websitePlan.monthly}
    </p>
    <p class="cta-guarantee">You see it work before you pay a dollar.</p>
    <a href="/#contact" class="btn btn-primary cta-btn btn-shimmer" data-magnetic>
      <span>Get your free demo</span>
      <span class="btn-arrow">&rarr;</span>
    </a>
    <a href="/pricing" class="cta-pricing-link">See full pricing &rarr;</a>
  </div>
</section>

<style>
  /* Graphite-to-black — same closing-beat shape/direction the CTA band has
     always used, regraded from teal-to-navy to the monochrome system, with
     a faint silver glow standing in for the old accent's warmth. */
  .final-cta {
    background:
      radial-gradient(ellipse 60% 80% at 85% 0%, rgba(216, 216, 216, 0.08), transparent 60%),
      linear-gradient(135deg, #3A3A3A 0%, #050505 100%);
  }

  /* Wider than the shared .cta-band-inner default (560px) — this is the
     site's only closing CTA carrying extra price-line copy, so it needs
     the room. */
  .cta-inner {
    max-width: 640px;
  }

  /* Slightly larger than the shared .cta-heading default — this is the
     one CTA on the homepage, the site's ultimate closing statement. */
  .cta-heading {
    font-size: clamp(1.75rem, 3.6vw, 2.75rem);
  }

  .cta-price-label {
    margin-top: var(--space-3);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-steel);
  }

  .cta-price-line {
    margin-top: 4px;
    font-size: 15px;
    font-weight: 500;
    color: var(--color-muted);
  }

  /* Genuinely secondary to the line above (the site's other price, not this
     CTA's own headline number) — the caption tier, not another one-off
     alpha of white. */
  .cta-price-line-secondary {
    margin-top: 2px;
    font-size: 13px;
    font-weight: 400;
    color: var(--color-caption);
  }

  .cta-btn {
    margin-top: var(--space-4);
  }

  .cta-pricing-link {
    margin-top: var(--space-3);
    font-size: 14px;
    font-weight: 500;
    color: var(--color-amber);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color var(--transition-fast);
  }

  .cta-pricing-link:hover,
  .cta-pricing-link:focus-visible {
    color: var(--color-ivory);
  }
</style>
