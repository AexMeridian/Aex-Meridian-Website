---
// The one line that's been with you since the first pixel: a hairline in
// the left gutter with a traveling node at the current position, and a
// brief knot (tick + section name) each time a section boundary (.seam)
// passes. Becoming the process timeline / comparison race track is later
// work — those sections don't exist yet — this is the base hairline mode.
---

<nav class="meridian-rail" aria-hidden="true">
  <div class="meridian-rail-node"></div>
</nav>

<style>
  .meridian-rail {
    position: fixed;
    top: 0;
    bottom: 0;
    left: clamp(16px, 3vw, 40px);
    width: 1px;
    z-index: 40;
    background: linear-gradient(
      to bottom,
      transparent,
      rgba(242, 242, 242, 0.14) 8%,
      rgba(242, 242, 242, 0.14) 92%,
      transparent
    );
    pointer-events: none;
  }

  .meridian-rail-node {
    position: absolute;
    left: 50%;
    top: calc(var(--sun-progress, 0) * 100%);
    width: 7px;
    height: 7px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: var(--color-steel);
    box-shadow: 0 0 8px 1px rgba(var(--color-steel-rgb), 0.55);
  }

  .meridian-rail :global(.meridian-rail-knot) {
    position: absolute;
    left: 50%;
    display: flex;
    align-items: center;
    gap: 8px;
    transform: translate(-50%, -50%);
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .meridian-rail :global(.meridian-rail-knot.is-active) {
    opacity: 1;
  }

  .meridian-rail :global(.meridian-rail-knot-tick) {
    width: 12px;
    height: 1px;
    background: var(--color-steel);
  }

  .meridian-rail :global(.meridian-rail-knot-label) {
    font-family: var(--font-body);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ivory);
    white-space: nowrap;
  }

  @media (max-width: 860px) {
    .meridian-rail {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .meridian-rail-node {
      transition: none;
    }
  }
</style>
