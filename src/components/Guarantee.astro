---
import MeridianRule from './MeridianRule.astro';

const points = [
  {
    title: 'See it first.',
    body: 'I build a real, working version of your site, or demo a live agent trained on your business, before you commit. Not a mockup — the actual thing.',
  },
  {
    title: 'No setup fee until you decide.',
    body: "You decide whether it's worth moving forward. If it isn't, you owe nothing.",
  },
  {
    title: 'No long-term contract.',
    body: 'Monthly care is month to month. Cancel any time.',
  },
];
---

<section class="section guarantee seam mode-dark-bleed mode-glow" id="guarantee">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow">The guarantee</p>
      <h2 class="section-title">You see it work before you pay a dollar</h2>
    </div>

    <div class="guarantee-grid" data-reveal-stagger>
      {points.map((point) => (
        <div class="guarantee-item" data-reveal>
          <MeridianRule align="left" dot="none" class="guarantee-rule" />
          <h3 class="guarantee-title">{point.title}</h3>
          <p class="guarantee-body">{point.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .section-title {
    color: var(--color-ivory);
  }

  .guarantee-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }

  .guarantee-item {
    padding-top: var(--space-3);
  }

  .guarantee-item .guarantee-rule {
    margin-bottom: var(--space-3);
  }

  .guarantee-title {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-ivory);
    margin-bottom: var(--space-2);
  }

  .guarantee-body {
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-muted);
  }

  @media (max-width: 640px) {
    .guarantee-grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }
</style>
