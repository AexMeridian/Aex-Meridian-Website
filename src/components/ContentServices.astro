---
// Repurposed from a video/social teaser into the homepage's agents section
// as part of the agent-first repositioning — agents are now the flagship
// product and get the prominent early homepage slot content used to have
// (see index.astro for the new section order).
import { agentTiers } from '../data/pricing';

const offerings = [
  {
    title: agentTiers[0].name,
    summary: `From ${agentTiers[0].setup} setup + ${agentTiers[0].monthly} — answers your phone 24/7, texts back any missed call, and books the job.`,
    icon: '<path d="M5 4h4l2 5l-2.5 1.5a11 11 0 0 0 5 5l1.5 -2.5l5 2v4a2 2 0 0 1 -2 2a16 16 0 0 1 -15 -15a2 2 0 0 1 2 -2" />',
  },
  {
    title: agentTiers[1].name,
    summary: `From ${agentTiers[1].setup} setup + ${agentTiers[1].monthly} — qualifies visitors on your site and routes hot leads straight to you.`,
    icon: '<path d="M3 20l1.3 -3.9c-2.324 -3.437 -1.426 -7.872 2.1 -10.374c3.526 -2.501 8.59 -2.296 11.845 .48c3.255 2.777 3.695 7.266 1.029 10.501c-2.666 3.235 -7.615 4.215 -11.574 2.293l-4.7 1" />',
  },
  {
    title: agentTiers[2].name,
    summary: `From ${agentTiers[2].setup} setup + ${agentTiers[2].monthly} — responds to a new lead in seconds and follows up until they reply.`,
    icon: '<path d="M13 3l0 7l6 0l-8 11l0 -7l-6 0l8 -11" />',
  },
];
---

<section class="section content-services seam mode-editorial" id="agents-teaser">
  <div class="container content-split">
    <div class="content-copy">
      <div class="section-head" data-reveal>
        <p class="eyebrow">AI agents</p>
        <h2 class="section-title">The agent that catches what you'd otherwise miss</h2>
        <p class="section-subtext">
          Calls, messages, and leads — an AI agent answers, texts back, and follows
          up so your business stays responsive around the clock, without you
          touching anything.
        </p>
      </div>

      <ul class="content-summary" data-reveal>
        {offerings.map((offer) => (
          <li class="content-offer">
            <span class="content-icon-badge">
              <span class="content-icon" set:html={`<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${offer.icon}</svg>`} />
            </span>
            <span class="content-offer-copy">
              <span class="content-title">{offer.title}</span>
              <span class="content-body">{offer.summary}</span>
            </span>
          </li>
        ))}
      </ul>

      <p class="content-closing">
        <a href="/pricing">See full agent pricing &rarr;</a>
      </p>
      <p class="content-note">
        We also take on video and social content occasionally, by request.
      </p>
    </div>

    <!-- No real photography of finished agent work exists yet. A sourced
         stat stands in for the missing portfolio proof, styled as this
         site's existing dark-card convention rather than a decorative
         shape — same pattern used before for the video stat, now the
         agents pitch's own real number. -->
    <div class="content-proof" data-reveal>
      <p class="content-proof-number">85<span>%</span></p>
      <p class="content-proof-body">
        of people whose call goes unanswered never call back — most call a
        competitor instead.
      </p>
      <p class="content-proof-source">Source: ServiceTitan; 411 Locals, 2016.</p>
    </div>
  </div>
</section>

<style>
  /* .mode-editorial supplies the white background/ink text; this section
     just builds the asymmetric split on top — copy on the left, a
     lightweight CSS visual on the right. */
  .content-split {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: var(--space-6);
    align-items: center;
  }

  .section-head {
    margin-bottom: var(--space-5);
  }

  .section-head .eyebrow {
    margin-bottom: var(--space-2);
  }

  .section-title {
    color: var(--color-ink);
  }

  .section-subtext {
    margin-top: var(--space-2);
    font-size: 17px;
    line-height: 1.7;
    color: var(--color-ink-muted);
  }

  /* Stacked, not a 2-up grid — three agent lines now, each a full
     sentence, inside a column that's already just over half the section
     width (see .content-split). */
  .content-summary {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .content-offer {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .content-icon-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    background: rgba(61, 107, 107, 0.1);
    color: var(--color-teal);
  }

  .content-offer-copy {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .content-title {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }

  .content-body {
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-ink-muted);
  }

  .content-closing {
    margin-top: var(--space-5);
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .content-closing a {
    color: var(--color-teal);
    text-decoration: none;
    transition: var(--transition-fast);
  }

  .content-closing a:hover,
  .content-closing a:focus-visible {
    color: var(--color-steel);
  }

  .content-note {
    margin-top: var(--space-2);
    font-size: 13px;
    color: var(--color-ink-muted);
  }

  /* Proof card — a real, sourced stat standing in for the missing
     portfolio photography, styled as a dark tinted card (this site's
     existing dark-card convention) rather than a decorative shape. */
  .content-proof {
    position: relative;
    padding: var(--space-6) var(--space-5);
    background: linear-gradient(135deg, var(--color-navy) 0%, var(--color-teal) 130%);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-tinted-light);
    text-align: center;
  }

  .content-proof-number {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 7vw, 5rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-ivory);
  }

  .content-proof-number span {
    font-size: 0.5em;
    color: var(--color-steel);
  }

  .content-proof-body {
    margin-top: var(--space-2);
    font-size: 17px;
    line-height: 1.6;
    max-width: 32ch;
    margin-inline: auto;
    color: rgba(247, 245, 240, 0.85);
  }

  .content-proof-source {
    margin-top: var(--space-4);
    font-size: 12px;
    color: rgba(247, 245, 240, 0.5);
  }

  @media (max-width: 860px) {
    .content-split {
      grid-template-columns: 1fr;
    }

    .content-proof {
      max-width: 420px;
      margin: 0 auto;
    }
  }
</style>
