---
import { agentTiers, videoTiers } from '../data/pricing';

const offerings = [
  {
    title: 'AI agents that answer for you',
    summary: `From ${agentTiers[0].setup} setup + ${agentTiers[0].monthly} — a chat or voice agent that catches the calls and messages you'd otherwise miss.`,
    icon: '<path d="M3 20l1.3 -3.9c-2.324 -3.437 -1.426 -7.872 2.1 -10.374c3.526 -2.501 8.59 -2.296 11.845 .48c3.255 2.777 3.695 7.266 1.029 10.501c-2.666 3.235 -7.615 4.215 -11.574 2.293l-4.7 1" />',
  },
  {
    title: 'Video & social content',
    summary: `Walkthrough videos from ${videoTiers[0].price}, plus graphics and short-form clips — quoted per project, never a retainer.`,
    icon: '<path d="M15 10l4.553 -2.276a1 1 0 0 1 1.447 .894v6.764a1 1 0 0 1 -1.447 .894l-4.553 -2.276v-4z" /><path d="M3 6m0 2a2 2 0 0 1 2 -2h8a2 2 0 0 1 2 2v8a2 2 0 0 1 -2 2h-8a2 2 0 0 1 -2 -2z" />',
  },
];
---

<section class="section content-services seam mode-editorial" id="content-services">
  <div class="container content-split">
    <div class="content-copy">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Beyond the website</p>
        <h2 class="section-title">An agent that answers, and content that keeps you visible</h2>
        <p class="section-subtext">
          Businesses also come to us for an AI agent that catches missed calls and
          messages, and for video and social content — both built the same fast,
          affordable way as our sites, and both billed separately from hosting.
        </p>
      </div>

      <ul class="content-summary" data-reveal>
        {offerings.map((offer) => (
          <li class="content-offer">
            <span class="content-icon-badge">
              <span class="content-icon" set:html={`<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${offer.icon}</svg>`} />
            </span>
            <span class="content-offer-copy">
              <span class="content-title">{offer.title}</span>
              <span class="content-body">{offer.summary}</span>
            </span>
          </li>
        ))}
      </ul>

      <p class="content-closing">
        <a href="/pricing">See full pricing &rarr;</a>
      </p>
    </div>

    <!-- No real photography of finished video/social work exists yet. A
         decorative shape stack used to sit here communicating nothing —
         replaced with the same sourced stat this pitch actually rests on
         (also cited on How It Works), so the space next to the offer
         copy argues for the offer instead of just filling it. -->
    <div class="content-proof" data-reveal>
      <p class="content-proof-number">85<span>%</span></p>
      <p class="content-proof-body">
        of people say video has convinced them to buy a product or service.
      </p>
      <p class="content-proof-source">Source: Wyzowl, State of Video Marketing 2026.</p>
    </div>
  </div>
</section>

<style>
  /* .mode-editorial supplies the white background/ink text; this section
     just builds the asymmetric split on top — copy on the left, a
     lightweight CSS visual on the right. */
  .content-split {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: var(--space-6);
    align-items: center;
  }

  .section-head {
    margin-bottom: var(--space-5);
  }

  .section-head .eyebrow {
    margin-bottom: var(--space-2);
  }

  .section-title {
    color: var(--color-ink);
  }

  .section-subtext {
    margin-top: var(--space-2);
    font-size: 17px;
    line-height: 1.7;
    color: var(--color-ink-muted);
  }

  /* Condensed to a short, price-free summary — full tiers and numbers
     live on Pricing, this is just enough to know the service exists and
     to prompt the click through. */
  .content-summary {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }

  .content-offer {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .content-icon-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    background: rgba(61, 107, 107, 0.1);
    color: var(--color-teal);
  }

  .content-offer-copy {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .content-title {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }

  .content-body {
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-ink-muted);
  }

  .content-closing {
    margin-top: var(--space-5);
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .content-closing a {
    color: var(--color-teal);
    text-decoration: none;
    transition: var(--transition-fast);
  }

  .content-closing a:hover,
  .content-closing a:focus-visible {
    color: var(--color-steel);
  }

  /* Proof card — a real, sourced stat standing in for the missing
     portfolio photography, styled as a dark tinted card (this site's
     existing dark-card convention) rather than a decorative shape. */
  .content-proof {
    position: relative;
    padding: var(--space-6) var(--space-5);
    background: linear-gradient(135deg, var(--color-navy) 0%, var(--color-teal) 130%);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-tinted-light);
    text-align: center;
  }

  .content-proof-number {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 7vw, 5rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-ivory);
  }

  .content-proof-number span {
    font-size: 0.5em;
    color: var(--color-steel);
  }

  .content-proof-body {
    margin-top: var(--space-2);
    font-size: 17px;
    line-height: 1.6;
    max-width: 32ch;
    margin-inline: auto;
    color: rgba(247, 245, 240, 0.85);
  }

  .content-proof-source {
    margin-top: var(--space-4);
    font-size: 12px;
    color: rgba(247, 245, 240, 0.5);
  }

  @media (max-width: 860px) {
    .content-split {
      grid-template-columns: 1fr;
    }

    .content-proof {
      max-width: 420px;
      margin: 0 auto;
    }
  }

  @media (max-width: 640px) {
    .content-summary {
      grid-template-columns: 1fr;
    }
  }
</style>
