---
// Repurposed from a video/social teaser into the homepage's agents section
// as part of the agent-first repositioning — agents are now the flagship
// product and get the prominent early homepage slot content used to have
// (see index.astro for the new section order).
import { agentTiers } from '../data/pricing';

// Trimmed per Phase 6 of the page-genre rework: What We Do now owns the
// full comparison (mechanism, pricing, best-for, wrong-choice), so this
// stays a one-line teaser per agent — no prices restated here.
const offerings = [
  {
    title: agentTiers[0].name,
    summary: 'Answers your phone 24/7, texts back any missed call, and books the job.',
    icon: '<path d="M5 4h4l2 5l-2.5 1.5a11 11 0 0 0 5 5l1.5 -2.5l5 2v4a2 2 0 0 1 -2 2a16 16 0 0 1 -15 -15a2 2 0 0 1 2 -2" />',
  },
  {
    title: agentTiers[1].name,
    summary: 'Qualifies visitors on your site and routes hot leads straight to you.',
    icon: '<path d="M3 20l1.3 -3.9c-2.324 -3.437 -1.426 -7.872 2.1 -10.374c3.526 -2.501 8.59 -2.296 11.845 .48c3.255 2.777 3.695 7.266 1.029 10.501c-2.666 3.235 -7.615 4.215 -11.574 2.293l-4.7 1" />',
  },
  {
    title: agentTiers[2].name,
    summary: 'Responds to a new lead in seconds and follows up until they reply.',
    icon: '<path d="M13 3l0 7l6 0l-8 11l0 -7l-6 0l8 -11" />',
  },
];
---

<section class="section content-services seam mode-dark-bleed mode-glow" id="agents-teaser">
  <div class="container content-split">
    <div class="content-copy">
      <div class="section-head" data-reveal data-depth="8">
        <p class="eyebrow">AI agents</p>
        <h2 class="section-title">The agent that catches what you'd otherwise miss</h2>
        <p class="section-subtext">
          About 62% of small-business calls go unanswered. An AI agent answers,
          texts back a missed one, and follows up on a lead so your business
          stays responsive around the clock, without you touching anything.
        </p>
      </div>

      <ul class="content-summary" data-reveal-stagger>
        {offerings.map((offer) => (
          <li class="content-offer" data-reveal>
            <span class="content-icon-badge">
              <span class="content-icon" set:html={`<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${offer.icon}</svg>`} />
            </span>
            <span class="content-offer-copy">
              <span class="content-title">{offer.title}</span>
              <span class="content-body">{offer.summary}</span>
            </span>
          </li>
        ))}
      </ul>

      <p class="content-cta">
        <a href="/#contact">See what an agent would catch for you &rarr;</a>
      </p>
      <p class="content-closing">
        <a href="/what-we-do">See the full comparison &rarr;</a>
      </p>
      <p class="content-note">
        We also take on video and social content occasionally, by request.
      </p>
    </div>

    <!-- No real photography of finished agent work exists yet. A sourced
         stat stands in for the missing portfolio proof, styled as this
         site's existing dark-card convention rather than a decorative
         shape — same pattern used before for the video stat, now the
         agents pitch's own real number. -->
    <div class="content-proof" data-reveal data-magnetic="card">
      <p class="content-proof-number">85<span>%</span></p>
      <p class="content-proof-body">
        of callers whose call goes unanswered never call back — worth an
        estimated $126,000 a year in lost business for the average service
        company.
      </p>
      <p class="content-proof-source">Source: ServiceTitan; 411 Locals, 2016.</p>
    </div>
  </div>
</section>

<style>
  /* .mode-dark-bleed/.mode-glow supply the navy background, ivory text, and
     ambient wash; this section just builds the asymmetric split on top —
     copy on the left, the proof card on the right. */
  .content-split {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: var(--space-6);
    align-items: center;
  }

  .section-head {
    margin-bottom: var(--space-5);
  }

  .section-head .eyebrow {
    margin-bottom: var(--space-2);
  }

  .section-title {
    color: var(--color-ivory);
  }

  /* Stacked, not a 2-up grid — three agent lines now, each a full
     sentence, inside a column that's already just over half the section
     width (see .content-split). */
  .content-summary {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .content-offer {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .content-icon-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    background: rgba(140, 140, 140, 0.16);
    color: var(--color-steel);
  }

  .content-offer-copy {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .content-title {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-ivory);
  }

  .content-body {
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-muted);
  }

  /* The contextual ask right where the ROI stat lands — a step lighter than
     the site's primary "Get your free demo" CTA (same idea, phrased as what
     the visitor gets rather than what they have to book), and visually the
     stronger of the two links in this closing block since it's the one
     actually worth acting on here. */
  .content-cta {
    margin-top: var(--space-5);
  }

  .content-cta a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 20px;
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 600;
    color: var(--color-navy);
    background: var(--color-ivory);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: var(--transition);
  }

  .content-cta a:hover,
  .content-cta a:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
  }

  .content-closing {
    margin-top: var(--space-3);
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .content-closing a {
    color: var(--color-amber);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: var(--transition-fast);
  }

  .content-closing a:hover,
  .content-closing a:focus-visible {
    color: var(--color-ivory);
  }

  .content-note {
    margin-top: var(--space-2);
    font-size: 13px;
    color: var(--color-muted);
  }

  /* Proof card — a real, sourced stat standing in for the missing
     portfolio photography, styled as a dark tinted card (this site's
     existing dark-card convention) rather than a decorative shape. */
  .content-proof {
    position: relative;
    padding: var(--space-6) var(--space-5);
    background: linear-gradient(135deg, var(--color-navy) 0%, var(--color-teal) 130%);
    border: 1px solid transparent;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-tinted-light);
    text-align: center;
    transition: transform 0.35s var(--ease-out), box-shadow 0.35s var(--ease-out),
      border-color 0.35s var(--ease-out);
  }

  .content-proof:hover,
  .content-proof:focus-within {
    transform: translateY(-6px);
    box-shadow: var(--shadow-glow-steel);
    border-color: rgba(140, 140, 140, 0.4);
  }

  @media (prefers-reduced-motion: reduce) {
    .content-proof {
      transition: box-shadow 0.35s ease, border-color 0.35s ease;
    }

    .content-proof:hover,
    .content-proof:focus-within {
      transform: none;
    }
  }

  .content-proof-number {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 7vw, 5rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-ivory);
  }

  .content-proof-number span {
    font-size: 0.5em;
    color: var(--color-steel);
  }

  .content-proof-body {
    margin-top: var(--space-2);
    font-size: 17px;
    line-height: 1.6;
    max-width: 32ch;
    margin-inline: auto;
    color: rgba(242, 242, 242, 0.85);
  }

  .content-proof-source {
    margin-top: var(--space-4);
    font-size: 12px;
    color: var(--color-caption);
  }

  @media (max-width: 860px) {
    .content-split {
      grid-template-columns: 1fr;
    }

    .content-proof {
      max-width: 420px;
      margin: 0 auto;
    }
  }
</style>
