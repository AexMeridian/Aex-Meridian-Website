---
import '../styles/global.css';
import PageTransition from '../components/PageTransition.astro';
import Sky from '../components/Sky.astro';
import MeridianRail from '../components/MeridianRail.astro';
import { contactEmail, contactPhoneHref, socialLinks } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Aex Meridian — AI Agents & Websites for Small Businesses',
  description = 'AI agents that answer, qualify, and follow up for small businesses — plus the websites they run from. Built fast and handled start to finish.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL('/images/og.jpg', Astro.site);
const logoURL = new URL('/icon-512.png', Astro.site);

// sameAs only ever lists profiles that actually exist — matches the same
// "hidden until real" rule the footer's social icons follow (see
// Footer.astro and src/data/site.ts).
const sameAs = Object.values(socialLinks).filter(Boolean);

// Three service lines, each modeled as a schema.org Service so search
// engines can associate "Aex Meridian" with AI agents, not just websites —
// this is the machine-readable version of the page copy on /what-we-do.
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Aex Meridian',
  description: 'AI agents that answer, qualify, and follow up for small businesses — plus the websites they run from.',
  url: Astro.site?.toString(),
  email: contactEmail,
  telephone: contactPhoneHref.replace('tel:', ''),
  image: ogImageURL.toString(),
  logo: logoURL.toString(),
  priceRange: '$',
  areaServed: {
    '@type': 'City',
    name: 'Spokane',
  },
  ...(sameAs.length > 0 ? { sameAs } : {}),
  makesOffer: [
    {
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: 'AI Agents',
        description: 'An AI voice receptionist with missed-call text-back, a website chat and lead-qualification agent, and a speed-to-lead follow-up agent — always disclosed as AI, with a human escalation path.',
      },
    },
    {
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: 'Website Design & Development',
        description: 'A fast, mobile-responsive small-business website with hosting, edits, and support handled month to month — the site an AI agent runs from.',
      },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0A0E14" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} is:inline />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:wght@600&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Sky />
    <MeridianRail />
    <a href="#main-content" class="skip-link">Skip to content</a>
    <div class="scroll-progress" aria-hidden="true"></div>
    <PageTransition />
    <slot />

    <script>
      import { initRise } from '../scripts/rise.js';
      import { initCountUp } from '../scripts/countUp.js';
      import { initMagnetic } from '../scripts/magnetic.js';
      import { initScrollProgress } from '../scripts/scrollProgress.js';
      import { initScrollDrift } from '../scripts/scrollDrift.js';
      import { initPanelGlow } from '../scripts/panelGlow.js';
      import { initRafLoop } from '../scripts/raf-loop.js';
      import { initDepthField } from '../scripts/depthField.js';
      import { initMeridianRail } from '../scripts/meridianRail.js';
      import { initPointerLight } from '../scripts/pointerLight.js';
      import { initLazyVideo } from '../scripts/lazyVideo.js';

      initRise(document);
      initCountUp(document);
      initMagnetic(document);
      initScrollProgress(document);
      initScrollDrift(document);
      initPanelGlow(document);
      initRafLoop();
      initDepthField(document);
      initMeridianRail(document);
      initPointerLight();
      initLazyVideo(document);

      if (new URLSearchParams(location.search).has('sun-dev')) {
        import('../scripts/sunDevOverlay.js').then(({ initSunDevOverlay }) =>
          initSunDevOverlay(document)
        );
      }
    </script>
  </body>
</html>
