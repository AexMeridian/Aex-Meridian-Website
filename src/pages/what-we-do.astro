---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';
import MeridianRule from '../components/MeridianRule.astro';
import { websitePlan, agentTiers, bundleNote } from '../data/pricing';

const handled = [
  'Hosting, uptime, and security',
  'Routine edits: hours, photos, promotions',
  'No logins, dashboards, or tools to learn',
];

const agentTrust = [
  "Every agent discloses it's AI, on every channel, every time",
  'A human escalation path is always available — never a dead end',
  'Inbound only — no outbound calling or texting, ever',
];

// Matrix copy not already in data/pricing.ts. "oneLiner" condenses each
// agent's existing `description` field to one sentence — same facts, no
// new claims. "wrongChoice" is genuinely new content per the spec: drafted
// as the direct inverse of each agent's existing `bestFor` line, not as a
// new statistic or claim about the business. DRAFT — confirm wording with
// Caleb before treating as final published copy.
const matrixCopy: Record<string, { oneLiner: string; wrongChoice: string }> = {
  'voice-receptionist': {
    oneLiner: 'Answers every call 24/7, texts back the ones it misses, and books straight into your calendar.',
    wrongChoice: "Your phone barely rings, or someone's already answering every call.",
  },
  'website-chat': {
    oneLiner: 'Chats with visitors in real time, qualifies them against your own site content, and routes hot leads to you.',
    wrongChoice: "Your site doesn't get meaningful traffic yet — there's no one for it to talk to.",
  },
  'speed-to-lead': {
    oneLiner: 'The moment a form or ad lead comes in, it texts them back in seconds and follows up until they reply.',
    wrongChoice: "You don't run ads or take inbound leads — it has nothing to act on.",
  },
};

// The monthly figure is the one huge element in each agent row, so it's
// split for typesetting only — the amount set at monument scale, the "/mo"
// as a small suffix. Concatenated back it is byte-identical to
// agentTiers[n].monthly; no number is altered, rounded, or reworded.
const splitMonthly = (monthly: string) => {
  const i = monthly.indexOf('/');
  return i === -1
    ? { amount: monthly, unit: '' }
    : { amount: monthly.slice(0, i), unit: monthly.slice(i) };
};

const matrixAgents = agentTiers.map((agent) => ({
  id: agent.id,
  name: agent.name,
  featured: agent.id === 'voice-receptionist',
  monthly: splitMonthly(agent.monthly),
  setup: agent.setup,
  oneLiner: matrixCopy[agent.id].oneLiner,
  bestFor: agent.bestFor,
  wrongChoice: matrixCopy[agent.id].wrongChoice,
}));

// Build-time comparison — bar heights are an illustrative ratio (8:1) for
// "weeks to months" vs "within a week", not a claimed precise day count.
// Displayed labels are the dollar ranges and time descriptions already
// published elsewhere on the site, unchanged.
const buildCompare = [
  { name: 'Traditional agency', cost: '$2,000–$9,000+', time: 'Weeks to months to launch', weight: 8, highlighted: false },
  { name: 'Aex Meridian', cost: `${websitePlan.setup} flat`, time: 'Live in days — often within a week', weight: 1, highlighted: true },
];
const maxWeight = Math.max(...buildCompare.map((r) => r.weight));

// No real client sites exist yet — these are concept builds, not a
// portfolio. Each is a from-scratch design pass for a fictional business
// (fictional name, .example domain — reserved by RFC 2606 for exactly this,
// never a resolvable address), built to show range across genuinely
// different audiences rather than one template re-skinned three times.
// Every fact below is either invented-and-labeled-as-such or already
// published elsewhere on this site (agent names, "best agent fit" pairings)
// — nothing here claims to be a real client, a real result, or a real number.
const concepts = [
  {
    id: 'trades',
    domain: 'cascadeplumbing.example',
    initials: 'CP',
    name: 'Cascade Plumbing & Heating',
    category: 'Trades & home services',
    headline: 'Water heater out? We’re there today.',
    sub: '24/7 emergency service — same technician, upfront price before any work starts.',
    cta: 'Request service',
    navItems: ['Services', 'Service Area', 'Contact'],
    agent: 'Best agent fit: AI Voice Receptionist',
    note: 'Dark and utilitarian, built to load fast on a phone held by someone standing next to a leak — not someone idly browsing. The whole page answers one question: can they come now.',
  },
  {
    id: 'wellness',
    domain: 'stonewellmassage.example',
    initials: 'SM',
    name: 'Stonewell Massage & Recovery',
    category: 'Personal care & wellness',
    headline: 'An hour that’s actually just for you.',
    sub: 'Deep tissue, sports recovery, and prenatal massage — book online in under a minute.',
    cta: 'Book your session',
    navItems: ['Services', 'Book Online', 'About'],
    agent: 'Best agent fit: AI Voice Receptionist',
    note: 'Slower and quieter, with room to breathe — the opposite instinct from the plumbing site, because the two businesses are selling opposite feelings before a visitor reads a word.',
  },
  {
    id: 'retail',
    domain: 'marrowbakehouse.example',
    initials: 'MB',
    name: 'Marrow Bakehouse',
    category: 'Local shops & retail',
    headline: 'Baked before sunrise, gone by ten.',
    sub: 'Sourdough, pastry, and the daily board — see what’s in the case before you drive over.',
    cta: 'See today’s menu',
    navItems: ['Today’s Menu', 'Hours', 'Find Us'],
    agent: 'Best agent fit: Website Chat Agent',
    note: 'The board changes every morning, so the one job the site has is showing today’s answer — not a static menu that stopped being true six months ago.',
  },
];
---

<Layout
  title="What We Do — Aex Meridian"
  description="AI agents that answer, qualify, and follow up for small businesses — plus the website they run from. The pricing and what's included."
>
  <Header contactHref="#contact" />
  <main id="main-content" class="wwd-page">
    <!--
      OPENING — "the convergence." The reference photograph is not a
      centered composition: a vast empty dark field occupies the upper
      left, the subject cuts across on a hard diagonal and bleeds off the
      top and right edges, and a single blazing horizon line splits the
      frame asymmetrically with a mirrored floor beneath it. This hero is
      that frame, translated to type: the headline cascades down and to
      the right in three steps of decreasing scale (the diagonal), the
      Meridian Blade bleeds off the top-right behind it, and a full-bleed
      horizon line divides the hero at roughly two-thirds height — with
      the supporting material (subhead, actions, page index) living below
      it, in the reflective floor.
    -->
    <div class="wwd-open">
      <!-- The Meridian Blade — the one sculptural risk on this page, standing
           in for the reference photo's subject directly instead of using the
           photo itself as a background image. A pair of open curves with a
           raking-light gradient stroke (dark, then hot silver, then dark
           again along the path, echoing a single light source catching a
           brushed edge), bleeding off the top-right corner behind the
           opening copy. Used exactly once on the site. -->
      <svg class="meridian-blade" viewBox="0 0 800 520" preserveAspectRatio="xMaxYMin slice" aria-hidden="true">
        <defs>
          <linearGradient id="blade-gradient" x1="10%" y1="0%" x2="95%" y2="100%">
            <stop offset="0%" stop-color="#050505" stop-opacity="0" />
            <stop offset="18%" stop-color="#3A3A3A" />
            <stop offset="46%" stop-color="#FFFFFF" />
            <stop offset="72%" stop-color="#8C8C8C" />
            <stop offset="100%" stop-color="#050505" stop-opacity="0" />
          </linearGradient>
        </defs>
        <path
          d="M 790 15 C 630 35, 525 155, 465 315 C 432 402, 380 462, 296 486"
          fill="none"
          stroke="url(#blade-gradient)"
          stroke-width="2.5"
          stroke-linecap="round"
        />
        <path
          d="M 810 58 C 665 90, 562 202, 500 352 C 468 428, 415 472, 332 498"
          fill="none"
          stroke="url(#blade-gradient)"
          stroke-width="1.25"
          stroke-linecap="round"
          opacity="0.55"
        />
      </svg>

      <div class="wwd-open-upper">
        <div class="container wwd-open-stack">
          <p class="eyebrow wwd-eyebrow" data-reveal>What we do</p>
          <h1 class="wwd-title" data-reveal>
            <span class="wwd-title-a">The agent</span>
            <span class="wwd-title-b">that answers,</span>
            <span class="wwd-title-c">and the website it lives on</span>
          </h1>
        </div>
      </div>

      <div class="wwd-horizon" aria-hidden="true"></div>

      <div class="wwd-open-lower">
        <div class="container wwd-lower-grid" data-reveal>
          <div class="wwd-lower-lede">
            <p class="wwd-subhead">
              An AI agent that catches the calls and leads you're missing — plus the site
              it runs from. This page is the spec sheet: what each agent does, what it
              costs, and when it isn't the right call.
            </p>

            <div class="wwd-actions">
              <a href="#contact" class="btn btn-primary btn-shimmer" data-magnetic>
                <span>Get your free demo</span>
                <span class="btn-arrow">&rarr;</span>
              </a>
              <a href="/how-it-works" class="btn btn-ghost btn-shimmer" data-magnetic>
                <span>See who we work with</span>
              </a>
            </div>
          </div>

          <nav class="wwd-index" aria-label="On this page">
            <a href="#wwd-agents" class="wwd-index-row">
              <span class="wwd-index-number">01</span>
              <span class="wwd-index-label">AI agents</span>
              <span class="wwd-index-arrow" aria-hidden="true">&darr;</span>
            </a>
            <a href="#wwd-website" class="wwd-index-row">
              <span class="wwd-index-number">02</span>
              <span class="wwd-index-label">The website</span>
              <span class="wwd-index-arrow" aria-hidden="true">&darr;</span>
            </a>
            <a href="#wwd-concepts" class="wwd-index-row">
              <span class="wwd-index-number">03</span>
              <span class="wwd-index-label">Concept builds</span>
              <span class="wwd-index-arrow" aria-hidden="true">&darr;</span>
            </a>
          </nav>
        </div>
      </div>
    </div>

    <section class="section wwd-chat seam" id="wwd-chat">
      <div class="container">
        <div class="chat-placeholder" data-reveal>
          <p class="eyebrow">Try it</p>
          <h2 class="chat-placeholder-title">Ask the agent about Aex Meridian</h2>
          <p class="chat-placeholder-body">
            The plan is a live chat agent right here, trained on this page's own
            content, answering questions about the product by being the product.
            It isn't wired up yet — flagging it rather than faking it with a static
            mockup.
          </p>
          <p class="chat-placeholder-flag"><!-- PLACEHOLDER: real chat widget, needs a backend + API key not yet in this project --></p>
        </div>
      </div>
    </section>

    <section class="section wwd-agents seam mode-glow" id="wwd-agents">
      <div class="container">
        <div class="section-head" data-reveal>
          <p class="eyebrow">AI agents</p>
          <h2 class="section-title">The team member who never misses a call</h2>
          <p class="section-subtext">
            Roughly 62% of small-business calls go unanswered, and about 85% of
            those callers never call back — worth an estimated $126,000 a year in
            lost business for the average service company. An agent catches it:
            answers the call, texts back a missed one, follows up on a lead, and
            books the job, all without you touching anything.
          </p>
          <p class="section-source">Source: ServiceTitan; 411 Locals, 2016.</p>
        </div>

        <!--
          AGENT LEDGER — the price is the monument. Each agent's monthly
          figure is set at a scale that tracks the figure itself: the
          flagship's $300–$450 is a full-width headline in its own right,
          Speed-to-Lead's $200–$350 is smaller, Website Chat's $150–$250
          smaller still. The typography literally charts the cost, so the
          three rows can never read as three equal cards, and every row has
          exactly one thing the eye lands on. Each row also steps further
          right than the one above it — the receding diagonal the reference
          photograph runs on — so the section drifts toward a vanishing
          point as it descends instead of stacking on a safe left rail.
        -->
        <div class="agent-ledger" data-reveal-stagger>
          {matrixAgents.map((agent, i) => (
            <article class:list={['agent-row', `agent-row--${i + 1}`, agent.featured && 'is-featured']} data-reveal>
              <p class="agent-fig">
                <span class="agent-fig-amount">{agent.monthly.amount}</span><span class="agent-fig-unit">{agent.monthly.unit}</span>
              </p>
              <p class="agent-fig-label">Monthly, scoped to volume</p>

              <div class="agent-detail">
                <header class="agent-head">
                  <span class="agent-index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                  <h3 class="agent-name">{agent.name}</h3>
                  {agent.featured && <span class="agent-flag">Flagship</span>}
                </header>

                <p class="agent-does">{agent.oneLiner}</p>

                <p class="agent-setup">
                  <span class="agent-setup-label">Setup</span>
                  <span class="agent-setup-value">{agent.setup}</span>
                </p>

                <div class="agent-notes">
                  <p>
                    <span class="agent-note-label">Best for</span>
                    {agent.bestFor}
                  </p>
                  <p class="agent-note--caveat">
                    <span class="agent-note-label">Wrong choice if</span>
                    {agent.wrongChoice}
                  </p>
                </div>
              </div>
            </article>
          ))}
        </div>

        <div class="handled-row" data-reveal>
          <div class="handled-card">
            <p class="handled-heading">Every agent, guaranteed</p>
            <ul class="handled-list">
              {agentTrust.map((item) => (
                <li>
                  <span class="handled-icon" set:html={`<svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>`} />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="price-card brushed-panel">
            <p class="price-label">Setup, every time</p>
            <p class="price-line">{agentTiers[0].setup} <span>per agent, flat</span></p>
            <p class="bundle-note-text">{bundleNote}</p>
            <a href="/pricing#agents" class="bundle-link">See full agent pricing &rarr;</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section wwd-website seam mode-glow" id="wwd-website">
      <div class="container">
        <div class="section-head" data-reveal>
          <p class="eyebrow">The website</p>
          <h2 class="section-title">The front door your agent answers from</h2>
          <p class="section-subtext">
            Every site is custom-built on a modern, static-first stack — no WordPress,
            no plugins to break, no CMS to maintain. It's also the source material for
            your agent: the same content that describes your business becomes its
            knowledge base, so nothing gets built twice.
          </p>
        </div>

        <!--
          THE RATIO — the build-time comparison as a to-scale monolith
          instead of a progress bar. One towering, dull graphite slab and
          one short, blazing silver one, 8:1, standing on the page's own
          horizon line (the chart's baseline IS the horizon motif, with the
          mirror-floor reflection beneath it). Extreme scale contrast doing
          the arguing, the way the reference photo's single lit edge does
          against a vast dark field. The bars are aria-hidden; every fact
          is carried by the visible text labels underneath.
        -->
        <div class="ratio" data-reveal>
          <div class="ratio-stage" aria-hidden="true">
            {buildCompare.map((row) => (
              <div class="ratio-col">
                <span
                  class:list={['ratio-bar', row.highlighted && 'ratio-bar--us']}
                  style={`height: ${(row.weight / maxWeight) * 100}%`}
                ></span>
              </div>
            ))}
          </div>
          <div class="ratio-horizon" aria-hidden="true"></div>
          <div class="ratio-labels">
            {buildCompare.map((row) => (
              <div class:list={['ratio-label', row.highlighted && 'ratio-label--us']}>
                <p class="ratio-name">{row.name}</p>
                <p class="ratio-cost">{row.cost}</p>
                <p class="ratio-time">{row.time}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- One wide band here rather than the two-card pair used in the
             agents section above — the ratio graphic already carries the
             price argument, so this section closes on a single quiet
             ledger instead of repeating the section rhythm verbatim. -->
        <div class="site-band" data-reveal>
          <div class="site-band-list">
            <p class="handled-heading">Handled for you</p>
            <ul class="handled-list">
              {handled.map((item) => (
                <li>
                  <span class="handled-icon" set:html={`<svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>`} />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="site-band-price">
            <p class="site-price-label">One plan, no tiers</p>
            <p class="site-price-line">{websitePlan.setup} <span>one-time setup</span></p>
            <p class="site-price-line">{websitePlan.monthly} <span>hosting, security &amp; edits</span></p>
          </div>
        </div>
      </div>
    </section>

    <section class="section wwd-concepts seam mode-glow" id="wwd-concepts">
      <div class="container">
        <div class="section-head section-head--offset" data-reveal>
          <p class="eyebrow">Not real clients</p>
          <h2 class="section-title">Three businesses, three different builds</h2>
          <p class="section-subtext">
            No portfolio yet — so here's a from-scratch design pass for three
            different kinds of businesses instead. Not a template reused three
            times; yours would look like this, specific to you.
          </p>
        </div>

        <!--
          CONCEPT BUILDS — three compositions, not three rows of the same
          composition. Cascade is shot close: an oversized frame bleeding
          off the right edge with the copy squeezed into a narrow column
          beside it. Stonewell is shot far: a small frame stranded at the
          right of a wide empty field, its name set large in the space
          that opens up. Marrow sits between the two and bleeds off the
          left edge instead. The mockups' internal type scales with
          --mock-base, so "closer" genuinely means closer rather than just
          wider. The frames are aria-hidden; the "not a real client"
          disclosure lives in the visible .concept-tag text.
        -->
        <div class="concept-list" data-reveal-stagger>
          {concepts.map((c, i) => (
            <article class:list={['concept-row', `concept-row--${i + 1}`]} data-reveal>
              <div class="concept-visual">
                <div class:list={['concept-frame', `concept-frame--${c.id}`]} aria-hidden="true">
                  <div class="concept-chrome">
                    <span class="concept-chrome-dots"><i></i><i></i><i></i></span>
                    <span class="concept-chrome-url">{c.domain}</span>
                  </div>
                  <div class="concept-screen">
                    <div class="concept-mock-nav">
                      <span class="concept-mock-logo">{c.initials}</span>
                      {c.navItems.map((item) => <span class="concept-mock-navitem">{item}</span>)}
                    </div>
                    <div class="concept-mock-hero">
                      <div class="concept-mock-text">
                        <p class="concept-mock-eyebrow">{c.category}</p>
                        <h4 class="concept-mock-headline">{c.headline}</h4>
                        <p class="concept-mock-sub">{c.sub}</p>
                        <span class="concept-mock-cta">{c.cta} &rarr;</span>
                      </div>
                      <div class="concept-mock-photo"></div>
                    </div>
                  </div>
                </div>
              </div>

              <div class="concept-copy">
                <p class="concept-tag">Concept &mdash; not a real client</p>
                <p class="concept-category">{c.category}</p>
                <h3 class="concept-name">{c.name}</h3>
                <p class="concept-note">{c.note}</p>
                <p class="concept-agent">{c.agent}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section wwd-cta cta-band">
      <video class="cta-band-video" data-src="/videos/cta-depth.mp4" muted playsinline loop preload="none" aria-hidden="true"></video>
      <div class="container wwd-cta-inner cta-band-inner" data-reveal>
        <MeridianRule dot="none" align="left" class="cta-rule" />
        <h2 class="cta-heading">Ready to talk about your project?</h2>
        <p class="cta-sub">No pressure, no jargon — just a conversation about what you need.</p>
        <p class="cta-guarantee">You see it work before you pay a dollar.</p>
        <a href="#contact" class="btn btn-primary btn-shimmer" data-magnetic>
          <span>Get your free demo</span>
          <span class="btn-arrow">&rarr;</span>
        </a>
      </div>
    </section>
    <ContactForm />
  </main>
  <Footer contactHref="#contact" />
</Layout>

<style>
  /* overflow-x: clip (not hidden) lets the concept frames bleed past the
     viewport edge without creating a scroll container — so position:sticky
     elsewhere and the shared header (which lives outside <main>) are both
     unaffected, and no horizontal scrollbar appears. */
  .wwd-page {
    background-color: var(--color-navy);
    color: var(--color-ivory);
    overflow-x: clip;
  }

  .wwd-page .eyebrow {
    color: var(--color-steel);
  }

  /* ------------------------------------------------------------------
     OPENING — the convergence
     ------------------------------------------------------------------ */

  .wwd-open {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-height: clamp(560px, 86vh, 880px);
  }

  .meridian-blade {
    position: absolute;
    /* Bleeds off the top and right edges of the frame, the way the subject
       does in the reference photograph — not contained inside a margin —
       and dissolves into haze before it reaches the horizon, so the seam
       stays the only thing crossing the lower half of the frame. */
    top: -10%;
    right: -11%;
    z-index: 0;
    width: min(76%, 900px);
    height: 112%;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(to bottom, #000 46%, transparent 74%);
    mask-image: linear-gradient(to bottom, #000 46%, transparent 74%);
  }

  @media (max-width: 860px) {
    /* The blade needs width to read as a sweeping curve, not a scribble —
       under that width it's quieter to drop it than to cram it in. */
    .meridian-blade {
      display: none;
    }
  }

  .wwd-open-upper {
    position: relative;
    z-index: 1;
    flex: 1;
    display: flex;
    padding: var(--space-6) 0 var(--space-5);
  }

  .wwd-open-stack {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 100%;
    gap: var(--space-6);
  }

  .wwd-eyebrow {
    align-self: flex-start;
  }

  /* The diagonal. Three steps, each further right and (after the second)
     sharply smaller — the headline cuts across the frame instead of
     stacking in a centered text column. */
  .wwd-title {
    display: block;
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--color-ivory);
    letter-spacing: -0.035em;
    line-height: 0.9;
  }

  .wwd-title-a,
  .wwd-title-b {
    display: block;
    font-size: clamp(2.6rem, 9vw, 7.6rem);
  }

  .wwd-title-b {
    margin-left: clamp(16px, 9vw, 132px);
  }

  .wwd-title-c {
    display: block;
    margin-top: clamp(14px, 1.6vw, 24px);
    margin-left: clamp(32px, 31vw, 430px);
    max-width: 20ch;
    font-size: clamp(1.05rem, 2.3vw, 2rem);
    line-height: 1.18;
    letter-spacing: -0.015em;
    color: var(--color-amber);
  }

  /* The horizon — a full-bleed hot hairline with the photo's atmospheric
     haze sitting on it, splitting the hero asymmetrically (roughly two
     thirds above, one third below). Brightest at ~60% across, where the
     reference photo's vanishing point sits. */
  .wwd-horizon {
    position: relative;
    z-index: 1;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.35) 14%,
      rgba(255, 255, 255, 0.92) 60%,
      rgba(255, 255, 255, 0.22) 88%,
      transparent 100%
    );
  }

  .wwd-horizon::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: -44px;
    height: 88px;
    pointer-events: none;
    background: radial-gradient(ellipse 46% 100% at 60% 50%, rgba(255, 255, 255, 0.15), transparent 72%);
    filter: blur(10px);
  }

  /* Below the horizon: the mirror floor. A faint sheen falling away from
     the seam, carrying the supporting material. */
  .wwd-open-lower {
    position: relative;
    z-index: 1;
    padding: var(--space-5) 0 var(--space-6);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.055), rgba(255, 255, 255, 0) 72%);
  }

  .wwd-lower-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.78fr);
    gap: var(--space-6);
    align-items: start;
  }

  .wwd-subhead {
    font-size: 17px;
    line-height: 1.7;
    color: var(--color-muted);
    max-width: 46ch;
  }

  .wwd-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .wwd-actions .btn-ghost {
    border-color: rgba(242, 242, 242, 0.45);
  }

  .wwd-actions .btn-ghost:hover,
  .wwd-actions .btn-ghost:focus-visible {
    border-color: var(--color-ivory);
    background: rgba(242, 242, 242, 0.08);
  }

  /* Page index — a ruled contents list, not a row of pills. Numbers are a
     real index here (three named destinations on this page), set small in
     mono so they read as reference marks rather than as "steps." */
  .wwd-index {
    display: flex;
    flex-direction: column;
  }

  .wwd-index-row {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding: 13px 0;
    border-top: 1px solid rgba(242, 242, 242, 0.16);
    text-decoration: none;
    transition: border-color var(--transition-fast);
  }

  .wwd-index-row:last-child {
    border-bottom: 1px solid rgba(242, 242, 242, 0.16);
  }

  .wwd-index-row:hover,
  .wwd-index-row:focus-visible {
    border-top-color: var(--color-amber);
  }

  .wwd-index-number {
    font-family: var(--font-mono);
    font-size: 11px;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
    color: var(--color-steel);
  }

  .wwd-index-label {
    font-family: var(--font-display);
    font-size: clamp(16px, 1.5vw, 20px);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-ivory);
    transition: transform var(--transition-fast);
  }

  .wwd-index-arrow {
    margin-left: auto;
    font-size: 14px;
    color: rgba(242, 242, 242, 0.5);
    transition: transform var(--transition-fast), color var(--transition-fast);
  }

  .wwd-index-row:hover .wwd-index-arrow,
  .wwd-index-row:focus-visible .wwd-index-arrow {
    transform: translateY(3px);
    color: var(--color-amber);
  }

  /* Chat placeholder — dashed border deliberately reads as "not finished"
     rather than dressing up an empty feature as a real one. */
  .wwd-chat {
    padding: var(--space-4) 0;
  }

  .chat-placeholder {
    max-width: 640px;
    padding: var(--space-4);
    border: 1px dashed rgba(242, 242, 242, 0.28);
    border-radius: var(--radius-md);
  }

  .chat-placeholder-title {
    margin-top: var(--space-1);
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-ivory);
  }

  .chat-placeholder-body {
    margin-top: var(--space-2);
    font-size: 14px;
    line-height: 1.65;
    color: var(--color-muted);
  }

  .chat-placeholder-flag {
    display: none;
  }

  .section-title {
    color: var(--color-ivory);
  }

  .section-source {
    margin-top: var(--space-2);
    font-size: 12px;
    color: var(--color-muted);
    opacity: 0.8;
  }

  /* One section head offset right instead of every head starting on the
     same left rail — small, but it's what keeps the page from having one
     rhythm from top to bottom. */
  .section-head--offset {
    margin-left: auto;
    margin-right: 0;
  }

  /* ------------------------------------------------------------------
     AGENT LEDGER — the price is the monument
     ------------------------------------------------------------------ */

  .agent-ledger {
    display: flex;
    flex-direction: column;
    margin-bottom: var(--space-7);
  }

  .agent-row {
    display: grid;
    grid-template-areas:
      'fig detail'
      'meta detail';
    grid-template-rows: auto 1fr;
    column-gap: clamp(24px, 4vw, 56px);
    padding: var(--space-5) 0 var(--space-5) var(--indent, 0);
    border-top: 1px solid rgba(242, 242, 242, 0.14);
  }

  .agent-row:last-child {
    border-bottom: 1px solid rgba(242, 242, 242, 0.14);
  }

  .agent-row.is-featured {
    border-top-color: rgba(216, 216, 216, 0.75);
  }

  /* The flagship gets its own shape, not just a bigger number: the figure
     spans the full width as a headline in its own right, with the detail
     tucked under its right shoulder. */
  .agent-row--1 {
    grid-template-areas:
      'fig fig'
      'meta detail';
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.5fr);
    --fig-size: clamp(2.9rem, 10.5vw, 8.6rem);
    --indent: 0;
    padding-top: var(--space-6);
    padding-bottom: var(--space-6);
  }

  .agent-row--2 {
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1fr);
    --fig-size: clamp(1.9rem, 4.6vw, 3.9rem);
    --indent: clamp(16px, 6vw, 100px);
  }

  .agent-row--3 {
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    --fig-size: clamp(2.2rem, 5.6vw, 4.9rem);
    --indent: clamp(32px, 11vw, 184px);
  }

  .agent-fig {
    grid-area: fig;
    display: flex;
    align-items: baseline;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.045em;
    line-height: 0.92;
    white-space: nowrap;
    color: var(--color-ivory);
  }

  .agent-fig-amount {
    font-size: var(--fig-size);
    font-weight: 500;
  }

  .agent-fig-unit {
    font-size: max(0.9rem, calc(var(--fig-size) * 0.2));
    font-weight: 400;
    letter-spacing: 0;
    color: var(--color-steel);
  }

  .agent-row--1 .agent-fig-amount {
    /* The one hot highlight in the section — the raking light catching the
       flagship's figure, the same direction every other highlight on these
       pages uses. */
    background: linear-gradient(100deg, #FFFFFF 8%, #D8D8D8 38%, #8C8C8C 74%, #5A5A5A 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .agent-fig-label {
    grid-area: meta;
    margin-top: var(--space-2);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-caption);
  }

  .agent-detail {
    grid-area: detail;
    align-self: start;
  }

  .agent-row--1 .agent-detail {
    margin-top: var(--space-2);
  }

  .agent-head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .agent-index {
    font-family: var(--font-mono);
    font-size: 11px;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
    color: var(--color-steel);
  }

  .agent-name {
    font-family: var(--font-display);
    font-size: clamp(19px, 2vw, 25px);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-ivory);
  }

  /* A ruled label, not a badge in a box. */
  .agent-flag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-amber);
  }

  .agent-flag::before {
    content: '';
    width: 22px;
    height: 1px;
    background: var(--color-amber);
  }

  .agent-does {
    margin-top: var(--space-2);
    max-width: 52ch;
    font-size: 15px;
    line-height: 1.65;
    color: var(--color-muted);
  }

  .agent-setup {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  .agent-setup-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-steel);
  }

  .agent-setup-value {
    font-family: var(--font-mono);
    font-size: 17px;
    font-variant-numeric: tabular-nums;
    color: var(--color-ivory);
  }

  .agent-notes {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: var(--space-3);
    max-width: 56ch;
    padding-top: var(--space-3);
    border-top: 1px solid rgba(242, 242, 242, 0.1);
  }

  .agent-notes p {
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .agent-note--caveat {
    font-style: italic;
    color: var(--color-caption);
  }

  .agent-note-label {
    display: inline;
    margin-right: 6px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-style: normal;
    color: var(--color-steel);
  }

  /* ------------------------------------------------------------------
     Cards shared by the agents section
     ------------------------------------------------------------------ */

  .handled-row {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-3);
  }

  .handled-card,
  .price-card {
    background: var(--color-ivory);
    border: 1px solid var(--color-line-on-light);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    transition: var(--transition);
  }

  .handled-card:hover {
    box-shadow: var(--shadow-tinted-dark);
  }

  .handled-heading {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    /* .handled-card sits on --color-ivory — the plain --color-steel token
       is ~3.7:1 there and fails AA for small text (see global.css), so this
       opts into the darker on-light variant the rest of the site already
       uses for text on light backgrounds. */
    color: var(--color-steel-on-light);
    margin-bottom: var(--space-3);
  }

  .handled-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .handled-list li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 15px;
    color: var(--color-ink);
  }

  .handled-icon {
    display: inline-flex;
    flex-shrink: 0;
    color: var(--color-teal);
  }

  /* .brushed-panel (global.css) supplies the surface itself — gradient,
     hairline border, top highlight, grain. Re-asserted here (not just
     relying on the shared class) because the earlier `.handled-card,
     .price-card { background: var(--color-ivory) }` rule above shares
     .brushed-panel's specificity and comes later in this same file, so it
     would otherwise win. */
  .price-card {
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: linear-gradient(165deg, #161616 0%, #0a0a0a 100%);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08), var(--shadow-tinted-dark);
  }

  .price-label {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-steel);
    margin-bottom: var(--space-2);
  }

  .price-line {
    font-family: var(--font-mono);
    font-size: 22px;
    font-weight: 500;
    color: var(--color-ivory);
    line-height: 1.5;
    font-variant-numeric: tabular-nums;
  }

  .price-line span {
    display: block;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 400;
    font-variant-numeric: normal;
    color: var(--color-caption);
  }

  .bundle-note-text {
    margin-top: var(--space-2);
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-muted);
  }

  .bundle-link {
    display: inline-block;
    margin-top: var(--space-2);
    font-size: 13px;
    font-weight: 600;
    color: var(--color-amber);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color var(--transition-fast);
  }

  .bundle-link:hover,
  .bundle-link:focus-visible {
    color: var(--color-ivory);
  }

  /* ------------------------------------------------------------------
     THE RATIO — build-time comparison
     ------------------------------------------------------------------ */

  .ratio {
    margin: var(--space-6) 0 var(--space-7);
  }

  .ratio-stage {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(24px, 9vw, 140px);
    align-items: end;
    height: clamp(240px, 36vw, 420px);
  }

  .ratio-col {
    display: flex;
    align-items: flex-end;
    height: 100%;
  }

  .ratio-bar {
    position: relative;
    display: block;
    width: min(100%, 210px);
    /* The dull monolith: a lot of mass, almost no light on it. */
    background: linear-gradient(175deg, #2E2E2E 0%, #131313 62%, #0B0B0B 100%);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-bottom: none;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }

  /* The brushed grain, only on the tall slab — the same whisper of
     material the rest of the system uses. */
  .ratio-bar::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.5;
    background-image: repeating-linear-gradient(
      100deg,
      rgba(255, 255, 255, 0.02) 0px,
      rgba(255, 255, 255, 0.02) 1px,
      transparent 1px,
      transparent 3px
    );
  }

  /* The mirror floor: each slab's reflection falling away below the
     horizon line, the gradient inverted so it reads as a true mirror. */
  .ratio-bar::after {
    content: '';
    position: absolute;
    top: 100%;
    left: -1px;
    right: -1px;
    height: min(100%, 74px);
    pointer-events: none;
    opacity: 0.3;
    background: linear-gradient(175deg, #0B0B0B 0%, #131313 38%, #2E2E2E 100%);
    -webkit-mask-image: linear-gradient(to bottom, #000, transparent);
    mask-image: linear-gradient(to bottom, #000, transparent);
  }

  /* The lit sliver. Tiny, and the only bright object in the frame. */
  .ratio-bar--us {
    background: linear-gradient(175deg, #FFFFFF 0%, #D8D8D8 46%, #8C8C8C 100%);
    border-color: rgba(255, 255, 255, 0.5);
    box-shadow: 0 0 34px rgba(216, 216, 216, 0.3), 0 0 90px rgba(216, 216, 216, 0.14);
  }

  .ratio-bar--us::before {
    display: none;
  }

  .ratio-bar--us::after {
    opacity: 0.42;
    background: linear-gradient(175deg, #8C8C8C 0%, #D8D8D8 54%, #FFFFFF 100%);
  }

  /* The chart's baseline is the page's own horizon motif — same hairline,
     same haze, standing the two slabs on the mirror floor. */
  .ratio-horizon {
    position: relative;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.28) 12%,
      rgba(255, 255, 255, 0.85) 72%,
      rgba(255, 255, 255, 0.28) 92%,
      transparent
    );
  }

  .ratio-horizon::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: -32px;
    height: 64px;
    pointer-events: none;
    background: radial-gradient(ellipse 40% 100% at 72% 50%, rgba(255, 255, 255, 0.16), transparent 72%);
    filter: blur(9px);
  }

  .ratio-labels {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(24px, 9vw, 140px);
    margin-top: var(--space-5);
  }

  .ratio-name {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-steel);
  }

  .ratio-cost {
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: clamp(1.3rem, 3vw, 2.4rem);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: rgba(242, 242, 242, 0.62);
  }

  .ratio-time {
    margin-top: var(--space-1);
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--color-muted);
  }

  .ratio-label--us .ratio-name,
  .ratio-label--us .ratio-cost {
    color: var(--color-ivory);
  }

  .ratio-label--us .ratio-time {
    color: rgba(242, 242, 242, 0.8);
  }

  /* ------------------------------------------------------------------
     Website section closing band
     ------------------------------------------------------------------ */

  .site-band {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: var(--space-5);
    align-items: center;
    padding: var(--space-4) var(--space-5);
    background: var(--color-ivory);
    border: 1px solid var(--color-line-on-light);
    border-radius: var(--radius-md);
  }

  .site-band-price {
    padding-left: var(--space-5);
    border-left: 1px solid var(--color-line-on-light);
  }

  .site-price-label {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-steel-on-light);
    margin-bottom: var(--space-2);
  }

  .site-price-line {
    font-family: var(--font-mono);
    font-size: 21px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    line-height: 1.35;
    color: var(--color-ink);
  }

  .site-price-line + .site-price-line {
    margin-top: var(--space-2);
  }

  .site-price-line span {
    display: block;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 400;
    font-variant-numeric: normal;
    color: var(--color-ink-muted);
  }

  /* ------------------------------------------------------------------
     CONCEPT BUILDS — three compositions, not three rows
     ------------------------------------------------------------------ */

  .concept-list {
    display: flex;
    flex-direction: column;
    gap: clamp(64px, 10vw, 150px);
    margin-top: var(--space-7);
  }

  .concept-row {
    display: grid;
    gap: clamp(24px, 4vw, 64px);
  }

  /* 01 — shot close. Oversized frame bleeding off the right edge, copy in
     a narrow column beside it. */
  .concept-row--1 {
    grid-template-columns: minmax(0, 0.58fr) minmax(0, 1.42fr);
    align-items: center;
  }

  .concept-row--1 .concept-visual {
    --mock-base: 16.5;
    margin-right: calc(-1 * (clamp(24px, 5vw, 64px) + 5vw));
  }

  /* 02 — shot far. A small frame stranded at the right of a wide empty
     field, its name set large in the space that opens up. */
  .concept-row--2 {
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.52fr);
    align-items: start;
  }

  .concept-row--2 .concept-visual {
    --mock-base: 10.5;
    margin-top: var(--space-5);
  }

  .concept-row--2 .concept-name {
    font-size: clamp(30px, 4.4vw, 54px);
  }

  .concept-row--2 .concept-note {
    max-width: 44ch;
  }

  /* 03 — the middle distance, bleeding off the left edge instead. */
  .concept-row--3 {
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.72fr);
    align-items: end;
  }

  .concept-row--3 .concept-visual {
    --mock-base: 13;
    margin-left: calc(-1 * (clamp(24px, 5vw, 64px) + 4vw));
  }

  .concept-row--3 .concept-copy {
    padding-bottom: var(--space-4);
  }

  .concept-visual {
    perspective: 1400px;
  }

  .concept-frame {
    font-size: calc(1px * var(--mock-base, 13));
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid rgba(242, 242, 242, 0.12);
    box-shadow: var(--shadow-tinted-dark);
    transition: transform 0.4s var(--ease-out);
  }

  .concept-row:hover .concept-frame {
    transform: rotateY(-2deg) rotateX(1deg) scale(1.015);
  }

  .concept-chrome {
    display: flex;
    align-items: center;
    gap: 1.6em;
    padding: 0.8em 1.1em;
    background: #141414;
    border-bottom: 1px solid rgba(242, 242, 242, 0.08);
  }

  .concept-chrome-dots {
    display: flex;
    gap: 0.38em;
    flex-shrink: 0;
  }

  .concept-chrome-dots i {
    display: block;
    width: 0.54em;
    height: 0.54em;
    border-radius: 50%;
    background: rgba(242, 242, 242, 0.22);
  }

  .concept-chrome-url {
    font-family: var(--font-mono);
    font-size: 0.88em;
    font-variant-numeric: tabular-nums;
    color: rgba(242, 242, 242, 0.45);
    padding: 0.22em 0.8em;
    background: rgba(242, 242, 242, 0.04);
    border-radius: var(--radius-full);
  }

  /* Every dimension inside the mockup is em-relative to --mock-base, so a
     row can genuinely be "closer" or "further away" rather than just
     wider or narrower. */
  .concept-screen {
    background: var(--cb);
    color: var(--cf);
    padding: 1.7em 1.85em 2.3em;
  }

  .concept-mock-nav {
    display: flex;
    align-items: center;
    gap: 1.4em;
    margin-bottom: 2.15em;
  }

  .concept-mock-logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2em;
    height: 2em;
    margin-right: auto;
    font-family: var(--font-display);
    font-size: 0.92em;
    font-weight: 600;
    color: var(--cb);
