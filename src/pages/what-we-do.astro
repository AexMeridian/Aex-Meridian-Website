---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MeridianRule from '../components/MeridianRule.astro';
import PageHero from '../components/PageHero.astro';
import { websitePlan, agentTiers, bundleNote } from '../data/pricing';

const costRows = [
  {
    name: 'Traditional agency',
    items: ['$2,000–$9,000+ to build', 'Weeks to months to launch', 'Maintenance often billed separately'],
    highlighted: false,
  },
  {
    name: 'Aex Meridian',
    items: ['A small fraction of that to launch', 'Live in days, not months', 'Hosting and upkeep included monthly'],
    highlighted: true,
  },
];

const handled = [
  'Hosting, uptime, and security',
  'Routine edits: hours, photos, promotions',
  'No logins, dashboards, or tools to learn',
];

const agentTrust = [
  "Every agent discloses it's AI, on every channel, every time",
  'A human escalation path is always available — never a dead end',
  'Inbound only — no outbound calling or texting, ever',
];

const workflow = [
  { number: '01', title: 'Gather', description: 'You send photos, key details, and any branding — takes minutes, not a meeting.' },
  { number: '02', title: 'Draft', description: 'We build a first pass around what you gave us — usually within a day or two.' },
  { number: '03', title: 'Review', description: 'Every draft is checked for accuracy and brand fit before you ever see it.' },
  { number: '04', title: 'Deliver', description: 'Ready to go live, branded to your business. Nothing publishes without your sign-off.' },
];
---

<Layout
  title="What We Do — Aex Meridian"
  description="AI agents that answer, qualify, and follow up for small businesses — plus the website they run from. The process, the pricing, and what's included in each."
>
  <Header />
  <main id="main-content">
    <PageHero
      video="/videos/what-we-do-bg.mp4"
      videoId="page-hero-loop"
      eyebrow="What we do"
      title="The agent that answers, and the website it lives on"
      subhead="An AI agent that catches the calls and leads you're missing — plus the site it runs from. Video and social content, available if you need it."
    >
      <div slot="actions" class="page-hero-actions">
        <a href="/#contact" class="btn btn-primary btn-shimmer" data-magnetic>
          <span>Book a free consultation</span>
          <span class="btn-arrow">&rarr;</span>
        </a>
        <a href="/how-it-works" class="btn btn-ghost btn-shimmer" data-magnetic>
          <span>See who we work with</span>
        </a>
      </div>

      <nav slot="extra" class="page-hero-index" aria-label="On this page">
        <a href="#wwd-agents" class="index-row">
          <span class="index-number">01</span>
          <span class="index-label">AI agents</span>
          <span class="index-arrow" aria-hidden="true">&rarr;</span>
        </a>
        <a href="#wwd-website" class="index-row">
          <span class="index-number">02</span>
          <span class="index-label">The website</span>
          <span class="index-arrow" aria-hidden="true">&rarr;</span>
        </a>
        <a href="#workflow-section" class="index-row">
          <span class="index-number">03</span>
          <span class="index-label">The process</span>
          <span class="index-arrow" aria-hidden="true">&rarr;</span>
        </a>
      </nav>
    </PageHero>

    <section class="section wwd-agents seam" id="wwd-agents">
      <div class="container">
        <div class="section-head" data-reveal>
          <p class="eyebrow">AI agents</p>
          <h2 class="section-title">The team member who never misses a call</h2>
          <p class="section-subtext">
            Roughly 62% of small-business calls go unanswered, and about 85% of
            those callers never call back — worth an estimated $126,000 a year in
            lost business for the average service company. An agent catches it:
            answers the call, texts back a missed one, follows up on a lead, and
            books the job, all without you touching anything.
          </p>
          <p class="section-source">Source: ServiceTitan; 411 Locals, 2016.</p>
        </div>

        <div class="agent-grid" data-reveal>
          {agentTiers.map((agent) => (
            <div class:list={['agent-card', agent.id === 'voice-receptionist' && 'agent-card--featured']}>
              {agent.id === 'voice-receptionist' && <span class="agent-badge">Flagship</span>}
              <h3 class="agent-name">{agent.name}</h3>
              <p class="agent-tagline">{agent.tagline}</p>
              <div class="agent-price-block">
                <p class="agent-price">
                  <span class="agent-price-value">{agent.setup}</span>
                  <span class="agent-price-unit">setup</span>
                </p>
                <p class="agent-price-secondary">{agent.monthly}</p>
              </div>
              <p class="agent-desc">{agent.description}</p>
              <p class="agent-best-for"><strong>Best for:</strong> {agent.bestFor}</p>
            </div>
          ))}
        </div>

        <div class="handled-row" data-reveal>
          <div class="handled-card">
            <p class="handled-heading">Every agent, guaranteed</p>
            <ul class="handled-list">
              {agentTrust.map((item) => (
                <li>
                  <span class="handled-icon" set:html={`<svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>`} />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="price-card">
            <p class="price-label">Setup, every time</p>
            <p class="price-line">{agentTiers[0].setup} <span>per agent, flat</span></p>
            <p class="bundle-note-text">{bundleNote}</p>
            <a href="/pricing#agents" class="bundle-link">See full agent pricing &rarr;</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section wwd-website seam" id="wwd-website">
      <div class="container">
        <div class="section-head" data-reveal>
          <p class="eyebrow">The website</p>
          <h2 class="section-title">The front door your agent answers from</h2>
          <p class="section-subtext">
            Every site is custom-built on a modern, static-first stack — no WordPress,
            no plugins to break, no CMS to maintain. It's also the source material for
            your agent: the same content that describes your business becomes its
            knowledge base, so nothing gets built twice.
          </p>
        </div>

        <div class="cost-grid" data-reveal>
          {costRows.map((row) => (
            <div class:list={['cost-card', { highlighted: row.highlighted }]}>
              <h3 class="cost-name">{row.name}</h3>
              <ul class="cost-list">
                {row.items.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          ))}
        </div>

        <div class="handled-row" data-reveal>
          <div class="handled-card">
            <p class="handled-heading">Handled for you</p>
            <ul class="handled-list">
              {handled.map((item) => (
                <li>
                  <span class="handled-icon" set:html={`<svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>`} />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="price-card">
            <p class="price-label">One plan, no tiers</p>
            <p class="price-line">{websitePlan.setup} <span>one-time setup</span></p>
            <p class="price-line">{websitePlan.monthly} <span>hosting, security &amp; edits</span></p>
          </div>
        </div>
      </div>
    </section>

    <section class="section wwd-content-note seam">
      <div class="container">
        <p class="content-note-text">
          We also take on walkthrough video and social content — occasionally, by
          request. It isn't a standing service with a published rate card; mention
          it when you reach out if it's something you need.
        </p>
      </div>
    </section>

    <section class="section wwd-workflow seam" id="workflow-section">
      <div class="beam-sweep" aria-hidden="true"></div>
      <div class="container">
        <div class="section-head" data-reveal>
          <p class="eyebrow">The process</p>
          <h2 class="section-title">From what you send us to what goes live</h2>
        </div>

        <div class="timeline">
          <div class="timeline-track" data-reveal aria-hidden="true">
            {workflow.map(() => <span class="track-node"></span>)}
          </div>

          <div class="timeline-grid">
            {workflow.map((step, i) => (
              <div class="timeline-step" data-reveal style={`transition-delay: ${i * 100}ms`}>
                <span class="step-index" aria-hidden="true">{step.number}</span>
                <h3 class="step-title">{step.title}</h3>
                <p class="step-desc">{step.description}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="section wwd-cta cta-band">
      <div class="container wwd-cta-inner cta-band-inner" data-reveal>
        <MeridianRule dot="none" align="left" class="cta-rule" />
        <h2 class="cta-heading">Ready to talk about your project?</h2>
        <p class="cta-sub">No pressure, no jargon — just a conversation about what you need.</p>
        <p class="cta-guarantee">You see it work before you pay a dollar.</p>
        <a href="/#contact" class="btn btn-primary btn-shimmer" data-magnetic>
          <span>Book a free consultation</span>
          <span class="btn-arrow">&rarr;</span>
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  /* On-page index — was a full-height side column beside the text
     (a second hero "shape" unique to this page); now a compact chip row
     stacked below the CTAs, so the hero's shell (height, alignment,
     column width) matches every other sub-page while this page keeps its
     one distinguishing feature: three functional jump-links. */
  .page-hero-index {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .index-row {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border: 1px solid rgba(247, 245, 240, 0.2);
    border-radius: var(--radius-full);
    background: rgba(10, 14, 20, 0.35);
    text-decoration: none;
    transition: var(--transition-fast);
  }

  .index-row:hover,
  .index-row:focus-visible {
    border-color: var(--color-steel);
    background: rgba(107, 135, 168, 0.16);
  }

  .index-number {
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-steel);
  }

  .index-label {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-ivory);
  }

  .index-arrow {
    color: rgba(247, 245, 240, 0.5);
    transition: transform var(--transition-fast), color var(--transition-fast);
  }

  .index-row:hover .index-arrow,
  .index-row:focus-visible .index-arrow {
    transform: translateX(2px);
    color: var(--color-steel);
  }

  /* The website */
  .wwd-website {
    background: var(--color-white);
    color: var(--color-ink);
  }


  .section-title {
    color: var(--color-ink);
  }

  .section-subtext {
    margin-top: var(--space-2);
    font-size: 17px;
    line-height: 1.7;
    color: var(--color-ink-muted);
  }

  .cost-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .cost-card {
    position: relative;
    background: var(--color-ivory);
    border: 1px solid var(--color-line-on-light);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    overflow: hidden;
    transition: var(--transition);
  }

  .cost-card.highlighted {
    background: var(--color-white);
    border: 2px solid var(--color-teal);
    box-shadow: var(--shadow-tinted-light);
  }

  /* Meridian top-accent — only on the "us" card, so it reads as a
     deliberate highlight rather than decorating both sides of a
     comparison equally. */
  .cost-card.highlighted::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--color-teal), var(--color-steel), var(--color-teal));
  }

  .cost-card.highlighted:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .cost-name {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin-bottom: var(--space-3);
  }

  .cost-card.highlighted .cost-name {
    color: var(--color-teal);
  }

  .cost-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .cost-list li {
    position: relative;
    padding-left: 20px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-ink-muted);
  }

  .cost-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 9px;
    width: 8px;
    height: 1px;
    background: var(--color-steel);
  }

  .handled-row {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-3);
  }

  .handled-card,
  .price-card {
    background: var(--color-ivory);
    border: 1px solid var(--color-line-on-light);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    transition: var(--transition);
  }

  .handled-card:hover {
    box-shadow: var(--shadow-tinted-light);
  }

  .handled-heading {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-steel);
    margin-bottom: var(--space-3);
  }

  .handled-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .handled-list li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 15px;
    color: var(--color-ink);
  }

  .handled-icon {
    display: inline-flex;
    flex-shrink: 0;
    color: var(--color-teal);
  }

  .price-card {
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: var(--color-navy);
    border: none;
    box-shadow: var(--shadow-tinted-dark);
  }

  .price-label {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-steel);
    margin-bottom: var(--space-2);
  }

  .price-line {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 600;
    color: var(--color-ivory);
    line-height: 1.5;
  }

  .price-line span {
    display: block;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 400;
    color: rgba(247, 245, 240, 0.6);
  }

  .bundle-link {
    display: inline-block;
    margin-top: var(--space-2);
    font-size: 13px;
    font-weight: 600;
    color: var(--color-steel);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color var(--transition-fast);
  }

  .bundle-link:hover,
  .bundle-link:focus-visible {
    color: var(--color-ivory);
  }

  /* AI agents — same light-section card language as the website section
     above it (ivory cards, teal accents), so the two "core product" sections
     read as a matched pair before the darker content section changes key. */
  .wwd-agents {
    background: var(--color-white);
    color: var(--color-ink);
  }

  .agent-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .agent-card {
    position: relative;
    background: var(--color-ivory);
    border: 1px solid var(--color-line-on-light);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    transition: var(--transition);
  }

  .agent-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .agent-card--featured {
    background: var(--color-white);
    border: 2px solid var(--color-teal);
    box-shadow: var(--shadow-tinted-light);
  }

  .agent-badge {
    position: absolute;
    top: -1px;
    right: var(--space-3);
    transform: translateY(-50%);
    background: var(--color-teal);
    color: var(--color-ivory);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: var(--radius-sm);
  }

  .agent-name {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }

  .agent-card--featured .agent-name {
    color: var(--color-teal);
  }

  .agent-tagline {
    margin-top: var(--space-1);
    font-size: 13px;
    color: var(--color-ink-muted);
  }

  .agent-price-block {
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-line-on-light);
  }

  .agent-price {
    display: flex;
    align-items: baseline;
    gap: var(--space-1);
  }

  .agent-price-value {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }

  .agent-price-unit {
    font-size: 12px;
    color: var(--color-ink-muted);
  }

  .agent-price-secondary {
    margin-top: 2px;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-teal);
  }

  .agent-desc {
    margin-top: var(--space-3);
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-ink-muted);
  }

  .agent-best-for {
    margin-top: var(--space-2);
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-ink-muted);
  }

  .agent-best-for strong {
    color: var(--color-ink);
  }

  /* Cited stat under the agents section-subtext — same small/muted
     treatment as the Wyzowl citation on ContentServices.astro and the
     video-stats source line on how-it-works.astro. */
  .section-source {
    margin-top: var(--space-2);
    font-size: 12px;
    color: var(--color-ink-muted);
    opacity: 0.8;
  }

  .bundle-note-text {
    margin-top: var(--space-2);
    font-size: 13px;
    line-height: 1.5;
    color: rgba(247, 245, 240, 0.7);
  }

  /* Content footnote — deliberately not a full section (no cards, no rate
     list): content is dormant/on-request per the current business plan, so
     this gets one quiet line, not the visual weight of a marketed line. */
  .wwd-content-note {
    background: var(--color-ivory);
    color: var(--color-ink);
    padding: var(--space-4) 0;
  }

  .content-note-text {
    max-width: 640px;
    margin: 0 auto;
    text-align: center;
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-ink-muted);
  }

  /* Workflow timeline */
  .wwd-workflow {
    position: relative;
    overflow: hidden;
    background: var(--color-white);
    color: var(--color-ink);
  }

  /* One-time light beam — sweeps top to bottom the first time this section
     scrolls into view, "illuminating" the steps as it passes. Triggered
     once via IntersectionObserver in the script below. */
  .beam-sweep {
    position: absolute;
    left: 0;
    right: 0;
    top: -25%;
    height: 45%;
    z-index: 1;
    pointer-events: none;
    opacity: 0;
    background: linear-gradient(
      180deg,
      transparent,
      rgba(107, 135, 168, 0.32),
      rgba(61, 107, 107, 0.22),
      transparent
    );
  }

  .beam-sweep.is-active {
    animation: beam-sweep-down 1.5s ease-out forwards;
  }

  @keyframes beam-sweep-down {
    0% {
      transform: translateY(-20%);
      opacity: 0;
    }
    12% {
      opacity: 1;
    }
    85% {
      opacity: 0.5;
    }
    100% {
      transform: translateY(320%);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .beam-sweep,
    .beam-sweep.is-active {
      display: none;
    }
  }

  .timeline-track {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 12px;
    margin-bottom: var(--space-5);
  }

  .timeline-track::before {
    content: '';
    position: absolute;
    left: 6px;
    right: 6px;
    top: 50%;
    height: 1px;
    background: linear-gradient(90deg, var(--color-teal), var(--color-steel), var(--color-teal));
    opacity: 0.5;
    transform: translateY(-50%) scaleX(0);
    transform-origin: left;
    transition: transform 0.9s var(--ease-out) 0.15s;
  }

  .timeline-track.in-view::before {
    transform: translateY(-50%) scaleX(1);
  }

  .track-node {
    position: relative;
    z-index: 1;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--color-teal);
    box-shadow: 0 0 0 4px var(--color-white), 0 0 14px rgba(61, 107, 107, 0.45);
  }

  .timeline-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-3);
  }

  .timeline-step {
    opacity: 0;
    transform: translateY(16px) scale(0.94);
    transition: opacity 0.5s var(--ease-out), transform 0.5s var(--ease-out);
  }

  .timeline-step.in-view {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .step-index {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 600;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px rgba(20, 24, 31, 0.18);
    margin-bottom: var(--space-2);
    transition: -webkit-text-stroke-color 0.3s ease;
  }

  .timeline-step:hover .step-index {
    -webkit-text-stroke-color: var(--color-teal);
  }

  .step-title {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin-bottom: var(--space-2);
  }

  .step-desc {
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-ink-muted);
  }

  /* Closing CTA */
  .wwd-cta {
    background: linear-gradient(135deg, #3D6B6B 0%, #16232B 100%);
  }

  .wwd-cta .btn {
    margin-top: var(--space-4);
  }

  @media (prefers-reduced-motion: reduce) {
    .timeline-track::before {
      transform: translateY(-50%) scaleX(1);
    }

    .timeline-step {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }

  @media (max-width: 860px) {
    .timeline-track {
      display: none;
    }

    .timeline-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-5);
    }
  }

  @media (max-width: 860px) {
    .agent-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .cost-grid {
      grid-template-columns: 1fr;
    }

    .handled-row {
      grid-template-columns: 1fr;
    }

    .timeline-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const workflowSection = document.getElementById('workflow-section');
  const beam = workflowSection?.querySelector('.beam-sweep');

  if (workflowSection instanceof HTMLElement && beam instanceof HTMLElement && !prefersReducedMotion) {
    const beamObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            beam.classList.add('is-active');
            beamObserver.unobserve(entry.target); // one-time only
          }
        });
      },
      { threshold: 0.25 }
    );
    beamObserver.observe(workflowSection);
  }
</script>
