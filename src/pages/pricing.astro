---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';
import MeridianRule from '../components/MeridianRule.astro';
import {
  websitePlan,
  overflowRate,
  agentTiers,
  startingWebsiteSetup,
  startingAgentPrice,
} from '../data/pricing';

const faqs = [
  {
    question: 'Why is this so much less than a typical agency quote?',
    answer:
      "Mainly stack and process: a modern static-first build with no CMS licensing, no plugin overhead, and no large agency team markup. The scope is real, not a bait-and-switch — see exactly what's included above.",
  },
  {
    question: 'How does agent pricing get set?',
    answer:
      "Every business's call and lead volume is different, so each agent's monthly price is quoted within the range shown once we understand your volume — you'll always have the exact number in writing before anything goes live.",
  },
  {
    question: 'Does an AI agent replace a real person?',
    answer:
      "No — it catches what would otherwise go to voicemail or an unanswered form, and hands off to a human for anything outside its scope. Every agent discloses it's AI and never pretends otherwise.",
  },
  {
    question: 'Why is the setup fee the same for everyone?',
    answer:
      "$500 covers the same core scope for almost every small business site — up to 5 pages, mobile-responsive, a working contact form. If your project genuinely needs more (extra pages, e-commerce, custom integrations), that's scoped and quoted separately, never hidden inside the base fee.",
  },
  {
    question: 'What does the $35 a month actually cover?',
    answer:
      "Hosting, your domain's SSL and security, uptime monitoring, and up to 20 minutes of content edits every month — swapping a photo, updating hours, fixing a typo. It's the same plan for every site; nothing upsells later.",
  },
  {
    question: 'Does the price go up once I sign?',
    answer:
      "No. The number you're quoted before the build starts is the number you pay — no add-on fees once work is underway, no retroactive increase on the monthly plan either.",
  },
  {
    question: 'Do I own my website?',
    answer:
      'Yes. Once the one-time setup fee is paid in full, ownership of the site design and its content transfers to you.',
  },
  {
    question: 'Is there a contract I get locked into?',
    answer:
      "No. The monthly plan and any agent or content engagement are all month-to-month, cancelable with 30 days' written notice — no multi-year terms, no financing agreement tied to the build.",
  },
  {
    question: "What if I need a change that's more than a quick edit?",
    answer: `${overflowRate} Additional pages beyond the first 5 are $100 each — always quoted before any work starts, so you're never guessing what a request will cost.`,
  },
  {
    question: "What if my business needs something outside the standard scope?",
    answer:
      'Say so on the consultation call and we\'ll tell you honestly whether it fits the standard build or needs a custom quote — either way, you\'ll know the number before you commit to anything.',
  },
  {
    question: 'Are agents and content billed with hosting?',
    answer:
      'No — agents and content are always billed separately from website hosting, whether one-time or monthly, so the monthly plan never comes with a surprise attached.',
  },
  {
    question: "What if I don't like what you built?",
    answer:
      "Most projects — website or agent — start speculatively: we build or demo the real thing first and show you. You decide if it's worth moving forward before any setup fee is due.",
  },
];

// Mirrors the visible FAQ below exactly (Google requires FAQPage content to
// match what a visitor actually sees) — eligible for a rich-result FAQ
// snippet in search.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};
---

<Layout
  title="Pricing — Aex Meridian"
  description="What a website or AI agent actually costs for a small business — flat setup fees, real monthly numbers, no quote-call runaround."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
  <Header forceSolid contactHref="#contact" />
  <main id="main-content" class="pricing-page">
    <div class="pricing-open">
      <video class="pricing-open-video" src="/videos/dawn-horizon.mp4" muted autoplay playsinline loop preload="auto" aria-hidden="true"></video>
      <MeridianRule dot="none" align="full" />
      <div class="container">
        <div class="pricing-open-inner" data-reveal>
          <p class="eyebrow">Pricing</p>
          <h1 class="pricing-title">Every price, one page.</h1>

          <div class="price-giant-row">
            <div class="price-giant-item">
              <p class="price-giant-value">{startingAgentPrice.replace('/mo', '')}<span>+/mo</span></p>
              <p class="price-giant-label">AI agents</p>
            </div>
            <div class="price-giant-item">
              <p class="price-giant-value">{startingWebsiteSetup}<span>+</span></p>
              <p class="price-giant-label">Website</p>
            </div>
          </div>

          <p class="pricing-open-sub">
            A flat $500 to set up any agent or the website. Monthly is a range for
            agents, scoped to your volume; one flat plan for the site. Both broken
            down below.
          </p>

          <!-- The core "why a real number, not a quote call" pitch — condensed
               from what used to be its own page. Deliberately one paragraph,
               not a 3-card "here's why agencies hide pricing" grid; that
               device is exactly the kind of thing that reads the same on
               every studio's site. -->
          <p class="pricing-open-note">
            Search "how much does a website cost" and most answers are "it
            depends," followed by a request to book a call — so you can't compare
            it to anything until you've already given someone 30 minutes. This is
            the real number, not a lead-gen quote form.
          </p>

          <!-- Everything the two giant numbers are starting-from figures
               for, at a glance — so the opening states the actual menu,
               not just its floor. -->
          <div class="pricing-glance" data-reveal-stagger>
            {agentTiers.map((agent) => (
              <div class="pricing-glance-item" data-reveal>
                <p class="pricing-glance-name">{agent.name}</p>
                <p class="pricing-glance-figures">
                  <span>{agent.setup} setup</span>
                  <span class="pricing-glance-dot" aria-hidden="true">&middot;</span>
                  <span>{agent.monthly}</span>
                </p>
              </div>
            ))}
            <div class="pricing-glance-item pricing-glance-item--website" data-reveal>
              <p class="pricing-glance-name">Website</p>
              <p class="pricing-glance-figures">
                <span>{websitePlan.setup} setup</span>
                <span class="pricing-glance-dot" aria-hidden="true">&middot;</span>
                <span>{websitePlan.monthly}</span>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <section class="section agents-pricing seam" id="agents">
      <div class="container">
        <div class="section-head" data-reveal>
          <p class="eyebrow">AI agents</p>
          <h2 class="section-title">One setup fee, priced by what the agent does</h2>
        </div>

        <div class="price-rows" data-reveal-stagger>
          {agentTiers.map((agent) => (
            <div class="price-row" data-reveal>
              <div class="price-row-name">
                <h3>{agent.name}</h3>
                <p>{agent.tagline}</p>
              </div>
              <div class="price-row-figures">
                <p class="price-row-figure">
                  <span class="price-row-value">{agent.setup}</span>
                  <span class="price-row-unit">setup</span>
                </p>
                <p class="price-row-figure">
                  <span class="price-row-value price-row-value--accent">{agent.monthly}</span>
                </p>
              </div>
            </div>
          ))}
        </div>

        <p class="pricing-note">
          What each agent does, who it's for, and when it's the wrong choice — the
          full comparison lives on <a href="/what-we-do">What We Do</a>.
        </p>
        <p class="pricing-note">
          Every agent discloses it's AI, on every channel, and always has a human
          escalation path. Inbound only — no outbound calling or texting, ever.
        </p>
      </div>
    </section>

    <section class="section website-pricing seam" id="website">
      <div class="container">
        <div class="section-head" data-reveal>
          <p class="eyebrow">Website</p>
          <h2 class="section-title">One flat plan for the site</h2>
        </div>

        <div class="price-block" data-reveal>
          <p class="price-block-tagline">{websitePlan.tagline}</p>

          <div class="price-block-figures">
            <p class="price-row-figure">
              <span class="price-row-value">{websitePlan.setup}</span>
              <span class="price-row-unit">one-time setup</span>
            </p>
            <p class="price-row-figure">
              <span class="price-row-value price-row-value--accent">{websitePlan.monthly}</span>
              <span class="price-row-unit">ongoing hosting &amp; care</span>
            </p>
          </div>

          <ul class="price-block-scope">
            {websitePlan.scope.map((item) => <li>{item}</li>)}
          </ul>

          <a href="#contact" class="btn btn-primary btn-shimmer" data-magnetic>
            <span>Book a free consultation</span>
            <span class="btn-arrow">&rarr;</span>
          </a>
        </div>
      </div>
    </section>

    <section class="section care-plans seam" id="care">
      <div class="container">
        <div class="section-head" data-reveal>
          <p class="eyebrow">What's covered</p>
          <h2 class="section-title">Every site gets the same care</h2>
          <p class="section-subtext">
            The setup fee is a one-time build cost — the {websitePlan.monthly} figure
            below is hosting, uptime, security, and small routine edits, so there's no
            separate hosting bill showing up later, and no charge for asking us to
            update a phone number or swap a photo.
          </p>
        </div>

        <ul class="care-list" data-reveal>
          {websitePlan.careFeatures.map((item) => <li>{item}</li>)}
        </ul>
        <p class="care-overflow">{overflowRate}</p>
      </div>
    </section>

    <section class="section price-breakdown seam" id="breakdown">
      <div class="container">
        <div class="section-head" data-reveal>
          <p class="eyebrow">Where the money goes</p>
          <h2 class="section-title">Where the $500 goes</h2>
        </div>

        <div class="breakdown-placeholder" data-reveal>
          <p>
            A real, itemized breakdown of the setup fee — build hours, hosting
            setup, domain/SSL, margin, whatever the actual split is — belongs here.
            It isn't built yet because it needs real figures, not estimates.
          </p>
          <p class="breakdown-flag"><!-- PLACEHOLDER: real $500 setup-fee breakdown, needs figures from Caleb --></p>
        </div>
      </div>
    </section>

    <section class="section content-footnote seam">
      <div class="container">
        <p class="content-footnote-text">
          Walkthrough video and social content are available occasionally, by
          request — not a standing service with a published rate card. Ask if it's
          something you need.
        </p>
      </div>
    </section>

    <section class="section pricing-faq seam" id="faq">
      <div class="container">
        <div class="section-head" data-reveal>
          <p class="eyebrow">Common questions</p>
          <h2 class="section-title">Before you reach out</h2>
        </div>

        <div class="faq-list" data-reveal>
          {faqs.map((faq, i) => (
            <>
              <details class="faq-item" name="faq" open={i === 0}>
                <summary class="faq-question">
                  <span>{faq.question}</span>
                  <span class="faq-icon" aria-hidden="true"></span>
                </summary>
                <div class="faq-answer" data-faq-answer>
                  <div class="faq-answer-inner">
                    <p>{faq.answer}</p>
                  </div>
                </div>
              </details>
              {i < faqs.length - 1 && <MeridianRule dot="none" align="full" class="faq-divider" />}
            </>
          ))}
        </div>
      </div>
    </section>

    <section class="section pricing-cta cta-band">
      <video class="cta-band-video" data-src="/videos/cta-depth.mp4" muted playsinline loop preload="none" aria-hidden="true"></video>
      <div class="container pricing-cta-inner cta-band-inner" data-reveal>
        <MeridianRule dot="none" align="left" class="cta-rule" />
        <h2 class="cta-heading">Not sure which fits?</h2>
        <p class="cta-sub">Tell us about your business — we'll tell you honestly what makes sense.</p>
        <p class="cta-guarantee">You see it work before you pay a dollar.</p>
        <a href="#contact" class="btn btn-primary btn-shimmer" data-magnetic>
          <span>Book a free consultation</span>
          <span class="btn-arrow">&rarr;</span>
        </a>
      </div>
    </section>
    <ContactForm />
  </main>
  <Footer contactHref="#contact" />
</Layout>

<style>
  .pricing-page {
    background-color: var(--color-navy);
    color: var(--color-ivory);
  }

  .pricing-page .eyebrow {
    color: var(--color-steel);
  }

  .pricing-title {
    margin-top: var(--space-2);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.9rem, 3.4vw, 2.75rem);
    line-height: 1.18;
    letter-spacing: -0.02em;
    color: var(--color-ivory);
  }

  .pricing-open {
    position: relative;
    overflow: hidden;
    padding: var(--space-6) 0 var(--space-5);
  }

  /* A dawn breaking on the horizon, low enough to read as light in the
     room rather than a photo — the same "one continuous dawn" idea the
     giant numbers already lean on, made literal behind them. */
  .pricing-open-video {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 65%;
    opacity: 0.16;
    filter: saturate(0.65) brightness(0.8);
    pointer-events: none;
  }

  .pricing-open > .container {
    position: relative;
    z-index: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .pricing-open-video {
      display: none;
    }
  }

  .pricing-open-inner {
    max-width: 760px;
  }

  /* The two opening numbers — deliberately larger than any headline
     anywhere else on the site, including Home's hero. Set directly as
     page content, not inside a card. */
  .price-giant-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    margin-top: var(--space-3);
  }

  /* The mono face, not the display serif — reserved sitewide for numerals
     and data specifically (see --font-mono in global.css), so the site's
     single biggest figures read as a real number, not an editorial
     flourish. The meridian gold ties these to the sun system's peak
     moment: this page opens with the boldest color statement on the site
     the same way it already opens with the boldest type statement. */
  .price-giant-value {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: clamp(4.2rem, 11vw, 8rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--color-meridian);
  }

  .price-giant-value span {
    font-size: 0.28em;
    font-weight: 600;
    color: var(--color-steel);
    margin-left: 4px;
  }

  .price-giant-label {
    margin-top: var(--space-1);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .pricing-open-sub {
    margin-top: var(--space-4);
    max-width: 520px;
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-muted);
  }

  .pricing-open-note {
    margin-top: var(--space-3);
    max-width: 520px;
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-muted);
    opacity: 0.85;
  }

  /* The full menu, not just its two starting figures — a compact strip
     of every price on the page, so the opening states the whole offer
     before anyone has to scroll to find it. */
  .pricing-glance {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    margin-top: var(--space-5);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-line);
  }

  .pricing-glance-item {
    min-width: 150px;
  }

  .pricing-glance-name {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-steel);
    margin-bottom: 4px;
  }

  .pricing-glance-figures {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--color-ivory);
  }

  .pricing-glance-dot {
    font-weight: 400;
    color: var(--color-muted);
  }

  .section-title {
    color: var(--color-ivory);
  }

  .section-subtext {
    margin-top: var(--space-2);
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-muted);
  }

  /* Price rows — hairline rules instead of cards, tabular figures, no
     background fill shift between rows. */
  .price-rows {
    display: flex;
    flex-direction: column;
  }

  .price-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--color-line);
  }

  .price-row-name h3 {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-ivory);
  }

  .price-row-name p {
    margin-top: 2px;
    font-size: 14px;
    color: var(--color-muted);
  }

  .price-row-figures {
    display: flex;
    gap: var(--space-5);
    flex-shrink: 0;
  }

  .price-row-figure {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
  }

  .price-row-value {
    font-family: var(--font-mono);
    font-size: 21px;
    font-weight: 600;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
    color: var(--color-ivory);
  }

  .price-row-value--accent {
    color: var(--color-steel);
  }

  .price-row-unit {
    font-size: 12px;
    color: var(--color-muted);
  }

  .pricing-note {
    margin-top: var(--space-4);
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-muted);
    max-width: 640px;
  }

  .pricing-note a {
    color: var(--color-steel);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .pricing-note a:hover,
  .pricing-note a:focus-visible {
    color: var(--color-ivory);
  }

  /* Website — one plain block, not a card: tagline, figures, scope list,
     one CTA. Same hairline-rule language as the agent rows above it. */
  .price-block {
    max-width: 640px;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-line);
  }

  .price-block-tagline {
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .price-block-figures {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    margin-top: var(--space-4);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }

  .price-block-figures .price-row-figure {
    align-items: flex-start;
    text-align: left;
  }

  .price-block-scope {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-2) var(--space-4);
  }

  .price-block-scope li {
    position: relative;
    padding-left: 20px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .price-block-scope li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 9px;
    width: 8px;
    height: 1px;
    background: var(--color-teal);
  }

  .price-block .btn {
    margin-top: var(--space-5);
  }

  /* Care list — same plain, unboxed treatment. */
  .care-list {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 640px;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .care-list li {
    position: relative;
    padding-left: 20px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .care-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 9px;
    width: 8px;
    height: 1px;
    background: var(--color-teal);
  }

  .care-overflow {
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-line);
    max-width: 640px;
    font-size: 14px;
    color: var(--color-muted);
  }

  /* Breakdown placeholder — same dashed-border "flagged, not faked"
     language as What We Do's chat placeholder. Real figures needed before
     this becomes a real itemized table. */
  .breakdown-placeholder {
    max-width: 640px;
    padding: var(--space-4);
    border: 1px dashed rgba(247, 245, 240, 0.24);
    border-radius: var(--radius-md);
  }

  .breakdown-placeholder p {
    font-size: 15px;
    line-height: 1.65;
    color: var(--color-muted);
  }

  .breakdown-flag {
    display: none;
  }

  .content-footnote-text {
    max-width: 640px;
    margin: 0 auto;
    text-align: center;
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-muted);
  }

  /* FAQ — already unboxed (native <details>, MeridianRule dividers); only
     the color tokens change for the dark page. */
  .faq-list {
    max-width: 720px;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .faq-item {
    padding: 0;
  }

  .faq-divider {
    margin: 0;
  }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3) 0;
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-ivory);
    cursor: pointer;
    list-style: none;
    transition: color var(--transition-fast);
  }

  .faq-item[open] .faq-question {
    color: var(--color-steel);
  }

  .faq-question:focus-visible {
    outline: 2px solid var(--color-steel);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-icon {
    position: relative;
    flex-shrink: 0;
    width: 20px;
    height: 20px;
  }

  .faq-icon::before,
  .faq-icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    background: var(--color-steel);
    transform: translate(-50%, -50%);
    transition: transform var(--transition-fast);
  }

  .faq-icon::before {
    width: 12px;
    height: 2px;
  }

  .faq-icon::after {
    width: 2px;
    height: 12px;
  }

  .faq-item[open] .faq-icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .faq-answer {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s var(--ease-out);
  }

  .faq-answer.is-open {
    grid-template-rows: 1fr;
  }

  .faq-answer-inner {
    overflow: hidden;
  }

  .faq-answer-inner p {
    padding: 0 0 var(--space-4);
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-muted);
  }

  /* Closing CTA — a more saturated version of the same navy, so it still
     reads as the page's final beat even though the rest of the page is
     dark now too. */
  .pricing-cta {
    background: linear-gradient(135deg, #3D6B6B 0%, #16232B 100%);
  }

  .pricing-cta .btn {
    margin-top: var(--space-4);
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-answer {
      transition: none !important;
    }
  }

  @media (max-width: 640px) {
    .price-row {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }

    .price-row-figures {
      gap: var(--space-4);
    }

    .price-row-figure {
      align-items: flex-start;
      text-align: left;
    }

    .price-block-figures {
      flex-direction: column;
      gap: var(--space-3);
    }

    .price-block-scope {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  document.querySelectorAll('.faq-item').forEach((item) => {
    const answer = item.querySelector('.faq-answer');
    if (!(answer instanceof HTMLElement) || !(item instanceof HTMLDetailsElement)) return;

    const syncOpenState = () => {
      answer.classList.toggle('is-open', item.open);
    };

    syncOpenState();
    item.addEventListener('toggle', syncOpenState);
  });
</script>
