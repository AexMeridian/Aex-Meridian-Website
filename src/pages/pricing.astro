---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';
import MeridianRule from '../components/MeridianRule.astro';
import {
  websitePlan,
  overflowRate,
  agentTiers,
  startingWebsiteSetup,
  startingAgentPrice,
} from '../data/pricing';

const faqs = [
  {
    question: 'Why is this so much less than a typical agency quote?',
    answer:
      "Mainly stack and process: a modern static-first build with no CMS licensing, no plugin overhead, and no large agency team markup. The scope is real, not a bait-and-switch — see exactly what's included above.",
  },
  {
    question: 'How does agent pricing get set?',
    answer:
      "Every business's call and lead volume is different, so each agent's monthly price is quoted within the range shown once we understand your volume — you'll always have the exact number in writing before anything goes live.",
  },
  {
    question: 'Does an AI agent replace a real person?',
    answer:
      "No — it catches what would otherwise go to voicemail or an unanswered form, and hands off to a human for anything outside its scope. Every agent discloses it's AI and never pretends otherwise.",
  },
  {
    question: 'Why is the setup fee the same for everyone?',
    answer:
      "$500 covers the same core scope for almost every small business site — up to 5 pages, mobile-responsive, a working contact form. If your project genuinely needs more (extra pages, e-commerce, custom integrations), that's scoped and quoted separately, never hidden inside the base fee.",
  },
  {
    question: 'What does the $35 a month actually cover?',
    answer:
      "Hosting, your domain's SSL and security, uptime monitoring, and up to 20 minutes of content edits every month — swapping a photo, updating hours, fixing a typo. It's the same plan for every site; nothing upsells later.",
  },
  {
    question: 'Does the price go up once I sign?',
    answer:
      "No. The number you're quoted before the build starts is the number you pay — no add-on fees once work is underway, no retroactive increase on the monthly plan either.",
  },
  {
    question: 'Do I own my website?',
    answer:
      'Yes. Once the one-time setup fee is paid in full, ownership of the site design and its content transfers to you.',
  },
  {
    question: 'Is there a contract I get locked into?',
    answer:
      "No. The monthly plan and any agent or content engagement are all month-to-month, cancelable with 30 days' written notice — no multi-year terms, no financing agreement tied to the build.",
  },
  {
    question: "What if I need a change that's more than a quick edit?",
    answer: `${overflowRate} Additional pages beyond the first 5 are $100 each — always quoted before any work starts, so you're never guessing what a request will cost.`,
  },
  {
    question: "What if my business needs something outside the standard scope?",
    answer:
      'Say so on the consultation call and we\'ll tell you honestly whether it fits the standard build or needs a custom quote — either way, you\'ll know the number before you commit to anything.',
  },
  {
    question: 'Are agents and content billed with hosting?',
    answer:
      'No — agents and content are always billed separately from website hosting, whether one-time or monthly, so the monthly plan never comes with a surprise attached.',
  },
  {
    question: "What if I don't like what you built?",
    answer:
      "Most projects — website or agent — start speculatively: we build or demo the real thing first and show you. You decide if it's worth moving forward before any setup fee is due.",
  },
];

// Mirrors the visible FAQ below exactly (Google requires FAQPage content to
// match what a visitor actually sees) — eligible for a rich-result FAQ
// snippet in search.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};
---

<Layout
  title="Pricing — Aex Meridian"
  description="What a website or AI agent actually costs for a small business — flat setup fees, real monthly numbers, no quote-call runaround."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
  <Header forceSolid contactHref="#contact" />
  <main id="main-content" class="pricing-page">
    <!--
      OPENING — "the drop." The reference photograph has one enormous form
      catching the light on the right of the frame, a much smaller element
      stranded low and left of it, a single blazing horizon splitting the
      frame well below centre, and a mirror floor under everything. This
      opening is that composition, not two price figures paired like a
      matched set: the agent figure is the monument — set at roughly three
      times the website figure, pushed past the right edge of the page's
      own margin, with the mirror reflection under it — and the website
      figure is the small object sitting low and left of it. The horizon
      runs full-bleed beneath both, and everything supporting (the lede and
      the full price ledger) lives below it, on the floor.
    -->
    <div class="pricing-open">
      <video class="pricing-open-video" src="/videos/dawn-horizon.mp4" muted autoplay playsinline loop preload="auto" aria-hidden="true"></video>
      <MeridianRule dot="none" align="full" />

      <div class="container po-upper" data-reveal>
        <div class="po-head">
          <p class="eyebrow">Pricing</p>
          <h1 class="pricing-title">Every price, one page.</h1>
        </div>

        <!-- The satellite. Small, low, left — and captioned underneath,
             where the monument is captioned above, so the two figures are
             never legible as a pair. -->
        <figure class="po-satellite">
          <p class="po-sat-value">{startingWebsiteSetup}<span>+</span></p>
          <figcaption class="po-cap po-cap--under">Website</figcaption>
        </figure>

        <!-- The monument. The one raking-light gradient this page spends,
             and the one mirrored reflection on the site. -->
        <figure class="po-monument">
          <figcaption class="po-cap">AI agents</figcaption>
          <p class="po-mon-value" data-reflect={startingAgentPrice.replace('/mo', '')}>{startingAgentPrice.replace('/mo', '')}<span>+/mo</span></p>
        </figure>
      </div>

      <!-- The horizon: full-bleed, brightest under the monument rather
           than at centre, with the photo's haze sitting on it. -->
      <div class="po-horizon" aria-hidden="true"></div>

      <div class="po-floor">
        <div class="container po-floor-grid" data-reveal>
          <div class="po-lede">
            <p class="pricing-open-sub">
              A flat $500 to set up any agent or the website. Monthly is a range for
              agents, scoped to your volume; one flat plan for the site. Both broken
              down below.
            </p>

            <!-- The core "why a real number, not a quote call" pitch — condensed
                 from what used to be its own page. Deliberately one paragraph,
                 not a 3-card "here's why agencies hide pricing" grid; that
                 device is exactly the kind of thing that reads the same on
                 every studio's site. -->
            <p class="pricing-open-note">
              Search "how much does a website cost" and most answers are "it
              depends," followed by a request to book a call — so you can't compare
              it to anything until you've already given someone 30 minutes. This is
              the real number, not a lead-gen quote form.
            </p>
          </div>

          <!-- Everything the two figures above are starting-from numbers
               for — a real price list with the figures set in a ruled
               right column, not four evenly-spaced cards. -->
          <dl class="po-ledger" data-reveal-stagger>
            {agentTiers.map((agent) => (
              <div class="po-ledger-row" data-reveal>
                <dt>{agent.name}</dt>
                <dd>
                  <span>{agent.setup} setup</span>
                  <span class="po-ledger-dot" aria-hidden="true">&middot;</span>
                  <span>{agent.monthly}</span>
                </dd>
              </div>
            ))}
            <div class="po-ledger-row" data-reveal>
              <dt>Website</dt>
              <dd>
                <span>{websitePlan.setup} setup</span>
                <span class="po-ledger-dot" aria-hidden="true">&middot;</span>
                <span>{websitePlan.monthly}</span>
              </dd>
            </div>
          </dl>
        </div>
      </div>
    </div>

    <!--
      AI AGENTS — "one constant, three variables." Every agent's setup fee
      is the same $500, so repeating it down three rows was three copies of
      one fact. It's hoisted out instead: the constant stands alone at
      monument scale on the left rail and stays put while the three
      variable monthlies scroll past it in a fine ruled ledger. One thing
      to look at, three things to read.
    -->
    <section class="section agents-pricing" id="agents">
      <div class="container agents-grid">
        <div class="agents-anchor" data-reveal>
          <p class="eyebrow">AI agents</p>
          <h2 class="section-title agents-title">One setup fee, priced by what the agent does</h2>

          <p class="agents-constant">
            <span class="agents-constant-fig">{agentTiers[0].setup}</span>
            <span class="agents-constant-unit">Setup &mdash; per agent, flat</span>
          </p>
        </div>

        <div class="agents-ledger">
          <div class="agent-lines" data-reveal-stagger>
            {agentTiers.map((agent) => (
              <article class="agent-line" data-reveal>
                <div class="agent-line-name">
                  <h3>{agent.name}</h3>
                  <p>{agent.tagline}</p>
                </div>
                <p class="agent-line-figure">
                  <span class="agent-line-value">{agent.monthly}</span>
                  <span class="agent-line-unit">scoped to your volume</span>
                </p>
              </article>
            ))}
          </div>

          <p class="pricing-note">
            What each agent does, who it's for, and when it's the wrong choice — the
            full comparison lives on <a href="/what-we-do">What We Do</a>.
          </p>
          <p class="pricing-note">
            Every agent discloses it's AI, on every channel, and always has a human
            escalation path. Inbound only — no outbound calling or texting, ever.
          </p>
        </div>
      </div>
    </section>

    <!-- THE CUT. The break between agent pricing and website pricing is a
         real diagonal across the full frame, not another identical section
         boundary: a hot hairline running corner to corner with the lit
         plane beginning underneath it. Everything above the cut sits on
         the dark field; the website plan and the care it comes with sit
         together on the floor below. -->
    <div class="cut" aria-hidden="true">
      <span class="cut-plane"></span>
      <span class="cut-line"></span>
      <span class="cut-haze"></span>
    </div>

    <section class="section website-pricing" id="website">
      <div class="container">
        <div class="website-rail">
          <div class="section-head website-head" data-reveal>
            <p class="eyebrow">Website</p>
            <h2 class="section-title">One flat plan for the site</h2>
          </div>

          <div class="price-block" data-reveal>
            <p class="price-block-tagline">{websitePlan.tagline}</p>

            <div class="price-block-figures">
              <p class="price-figure price-figure--lead">
                <span class="price-figure-value">{websitePlan.setup}</span>
                <span class="price-figure-unit">one-time setup</span>
              </p>
              <p class="price-figure">
                <span class="price-figure-value">{websitePlan.monthly}</span>
                <span class="price-figure-unit">ongoing hosting &amp; care</span>
              </p>
            </div>

            <ul class="price-block-scope">
              {websitePlan.scope.map((item) => <li>{item}</li>)}
            </ul>

            <a href="#contact" class="btn btn-primary btn-shimmer" data-magnetic>
              <span>Get your free demo</span>
              <span class="btn-arrow">&rarr;</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Care is the underside of the plan above it, not a fresh section:
         same lit plane, no divider between them, and weighted left where
         the plan is weighted right. -->
    <section class="section care-plans" id="care">
      <div class="container care-grid">
        <div class="care-head" data-reveal>
          <p class="eyebrow">What's covered</p>
          <h2 class="section-title">Every site gets the same care</h2>
        </div>

        <div class="care-body" data-reveal>
          <p class="section-subtext">
            The setup fee is a one-time build cost — the {websitePlan.monthly} figure
            below is hosting, uptime, security, and small routine edits, so there's no
            separate hosting bill showing up later, and no charge for asking us to
            update a phone number or swap a photo.
          </p>

          <ul class="care-list">
            {websitePlan.careFeatures.map((item) => <li>{item}</li>)}
          </ul>
          <p class="care-overflow">{overflowRate}</p>
        </div>
      </div>
    </section>

    <!-- Marginalia. The setup-fee breakdown isn't built yet and the
         content note is a footnote by nature — neither earns a full-width
         section of its own, so both run small, together, offset right,
         under a rule weighted the opposite way from the hero's horizon. -->
    <section class="section pricing-margin">
      <div class="container margin-grid">
        <div class="margin-note" id="breakdown" data-reveal>
          <p class="margin-label">Where the money goes</p>
          <h2 class="margin-title">Where the $500 goes</h2>
          <div class="breakdown-placeholder">
            <p>
              A real, itemized breakdown of the setup fee — build hours, hosting
              setup, domain/SSL, margin, whatever the actual split is — belongs here.
              It isn't built yet because it needs real figures, not estimates.
            </p>
            <p class="breakdown-flag"><!-- PLACEHOLDER: real $500 setup-fee breakdown, needs figures from Caleb --></p>
          </div>
        </div>

        <div class="margin-aside" data-reveal>
          <p class="content-footnote-text">
            Walkthrough video and social content are available occasionally, by
            request — not a standing service with a published rate card. Ask if it's
            something you need.
          </p>
        </div>
      </div>
    </section>

    <section class="section pricing-faq seam" id="faq">
      <div class="container faq-grid">
        <div class="faq-head" data-reveal>
          <p class="eyebrow">Common questions</p>
          <h2 class="section-title">Before you reach out</h2>
        </div>

        <!-- Offset right against a single vertical spine that brightens as
             it falls, rather than a dead-centre column. -->
        <div class="faq-list" data-reveal>
          {faqs.map((faq, i) => (
            <>
              <details class="faq-item" name="faq" open={i === 0}>
                <summary class="faq-question">
                  <span>{faq.question}</span>
                  <span class="faq-icon" aria-hidden="true"></span>
                </summary>
                <div class="faq-answer" data-faq-answer>
                  <div class="faq-answer-inner">
                    <p>{faq.answer}</p>
                  </div>
                </div>
              </details>
              {i < faqs.length - 1 && <MeridianRule dot="none" align="full" class="faq-divider" />}
            </>
          ))}
        </div>
      </div>
    </section>

    <section class="section pricing-cta cta-band">
      <video class="cta-band-video" data-src="/videos/cta-depth.mp4" muted playsinline loop preload="none" aria-hidden="true"></video>
      <div class="container pricing-cta-inner cta-band-inner" data-reveal>
        <MeridianRule dot="none" align="left" class="cta-rule" />
        <h2 class="cta-heading">Not sure which fits?</h2>
        <p class="cta-sub">Tell us about your business — we'll tell you honestly what makes sense.</p>
        <p class="cta-guarantee">You see it work before you pay a dollar.</p>
        <a href="#contact" class="btn btn-primary btn-shimmer" data-magnetic>
          <span>Get your free demo</span>
          <span class="btn-arrow">&rarr;</span>
        </a>
      </div>
    </section>
    <ContactForm />
  </main>
  <Footer contactHref="#contact" />
</Layout>

<style>
  /* overflow-x: clip (not hidden) lets the opening's monument run past the
     page's own margin without creating a scroll container — so the sticky
     agent anchor below and the shared header both still work, and no
     horizontal scrollbar appears. --bleed is the distance from the
     container's content edge out to the viewport edge. */
  .pricing-page {
    background-color: var(--color-navy);
    color: var(--color-ivory);
    overflow-x: clip;

    --gutter: clamp(24px, 5vw, 64px);
    --bleed: calc(-1 * (var(--gutter) + max(0px, (100vw - var(--max-width)) / 2)));
  }

  .pricing-page .eyebrow {
    color: var(--color-steel);
  }

  /* The headline is deliberately the quiet part of the opening — it names
     the page, the monument makes the argument. */
  .pricing-title {
    margin-top: var(--space-2);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.55rem, 2.5vw, 2.15rem);
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--color-ivory);
  }

  .pricing-open {
    position: relative;
    overflow: hidden;
    padding-top: var(--space-6);
  }

  /* A horizon breaking low in the frame, low enough to read as light in
     the room rather than a photo — grayscale like everything else on this
     page now, the color budget spent entirely on the homepage hero. */
  .pricing-open-video {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 65%;
    opacity: 0.16;
    filter: grayscale(1) saturate(0.65) brightness(0.8);
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .pricing-open-video {
      display: none;
    }
  }

  /* ------------------------------------------------------------------
     OPENING — the drop
     ------------------------------------------------------------------ */

  /* Two rows: the headline across the top, then the satellite and the
     monument sharing one row at opposite ends and opposite scales. They
     are separate grid columns, so the diagonal never becomes a collision
     no matter how the figure reflows. */
  .po-upper {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 0.42fr) minmax(0, 1fr);
    grid-template-areas:
      'head head'
      'sat  monument';
    column-gap: clamp(20px, 4vw, 64px);
    row-gap: clamp(28px, 4vw, 64px);
    align-items: end;
    padding-bottom: clamp(44px, 5vw, 82px);
  }

  .po-head {
    grid-area: head;
  }

  .po-head .pricing-title {
    max-width: 24ch;
  }

  .po-monument {
    grid-area: monument;
    /* <figure> carries a 1em 40px UA margin by default — cleared so the
       figures sit on the same rails as everything else on the page. */
    margin: 0;
    justify-self: end;
    /* Runs past the page's own margin into the gutter rather than stopping
       politely at the content edge — the subject is not contained in the
       frame. Stops short of the viewport edge so no glyph is ever lost. */
    margin-right: calc(var(--bleed) * 0.78);
    text-align: right;
  }

  /* A machined plate above the figure, not a caption under it — which
     leaves the mirror below the monument completely clear. */
  .po-cap {
    display: block;
    margin-bottom: clamp(10px, 1.2vw, 18px);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-amber);
  }

  .po-cap--under {
    margin: var(--space-2) 0 0;
    letter-spacing: 0.16em;
    color: var(--color-muted);
  }

  /* The mono face, not the display serif — reserved sitewide for numerals
     and data specifically (see --font-mono in global.css), so the site's
     single biggest figure reads as a real number, not an editorial
     flourish. The raking-light gradient (reserved for exactly one element
     per page) bypasses the shared --color-meridian token directly rather
     than overriding it, since raf-loop.js still reads that token live for
     the sitewide sun system. Its darkest stop is held at #6E6E6E — ~4:1
     on this background — so even the tail of the gradient clears AA for
     large text. */
  .po-mon-value {
    position: relative;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: clamp(4.2rem, 14vw, 12.5rem);
    line-height: 0.9;
    letter-spacing: -0.035em;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    background: linear-gradient(100deg, #FFFFFF 6%, #E4E4E4 34%, #A8A8A8 68%, #6E6E6E 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .po-mon-value span {
    font-size: 0.24em;
    font-weight: 600;
    color: var(--color-steel);
    margin-left: 6px;
    /* Not part of the gradient-text clip above — a plain flat gray reads
       more like a unit label than a second sculptural surface. */
    -webkit-background-clip: initial;
    background-clip: initial;
  }

  /* The one literal echo of the reference photo's mirror floor — a faint,
     fading reflection under the site's single largest figure. Duplicates
     the visible text via the data-reflect attribute (set in the markup)
     since a gradient-clipped ::after can't read its sibling <span>. */
  .po-mon-value::after {
    content: attr(data-reflect);
    position: absolute;
    left: 0;
    /* Inset by exactly the suffix's own advance width (4 monospace
       characters at 0.24em, plus its left margin) so the mirrored amount
       lands directly under the real one rather than under the unit. */
    right: calc(0.576em + 6px);
    top: calc(100% + 4px);
    height: 0.3em;
    overflow: hidden;
    color: rgba(255, 255, 255, 0.15);
    transform: scaleY(-1);
    -webkit-mask-image: linear-gradient(to top, rgba(0, 0, 0, 0.72), transparent 78%);
    mask-image: linear-gradient(to top, rgba(0, 0, 0, 0.72), transparent 78%);
    pointer-events: none;
    user-select: none;
  }

  /* The small object across the frame from the monument: flat silver, no
     gradient, no reflection. One thing catches the light. */
  .po-satellite {
    grid-area: sat;
    margin: 0;
    align-self: end;
    padding-bottom: clamp(4px, 1.6vw, 26px);
  }

  .po-sat-value {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: clamp(1.9rem, 4.2vw, 3.5rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    color: var(--color-amber);
  }

  .po-sat-value span {
    font-size: 0.34em;
    color: var(--color-steel);
    margin-left: 3px;
  }

  /* The horizon — full-bleed, brightest at ~74% across where the monument
     lands, not at centre, with the photo's haze sitting on it. */
  .po-horizon {
    position: relative;
    z-index: 1;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.22) 12%,
      rgba(255, 255, 255, 0.95) 74%,
      rgba(255, 255, 255, 0.28) 93%,
      transparent 100%
    );
  }

  .po-horizon::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: -46px;
    height: 92px;
    pointer-events: none;
    background: radial-gradient(ellipse 42% 100% at 74% 50%, rgba(255, 255, 255, 0.16), transparent 72%);
    filter: blur(11px);
  }

  /* Below the horizon: the floor. A faint sheen falling away from the seam,
     carrying everything that supports the two figures above it. */
  .po-floor {
    position: relative;
    z-index: 1;
    padding: var(--space-5) 0 var(--space-6);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.055), rgba(255, 255, 255, 0) 74%);
  }

  .po-floor-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.86fr);
    column-gap: clamp(32px, 6vw, 96px);
    row-gap: var(--space-5);
    align-items: start;
  }

  .pricing-open-sub {
    max-width: 46ch;
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-muted);
  }

  .pricing-open-note {
    margin-top: var(--space-3);
    max-width: 46ch;
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-muted);
    opacity: 0.85;
  }

  /* The full menu, not just its two starting figures — a real price list
     with names on the left rail and figures ruled off on the right, so the
     opening states the whole offer before anyone has to scroll. */
  .po-ledger {
    margin: 0;
    border-top: 1px solid rgba(242, 242, 242, 0.22);
  }

  .po-ledger-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 6px var(--space-3);
    padding: 12px 0;
    border-bottom: 1px solid var(--color-line);
  }

  .po-ledger dt {
    font-size: 13.5px;
    font-weight: 600;
    letter-spacing: -0.005em;
    color: var(--color-ivory);
  }

  .po-ledger dd {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 7px;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
    color: var(--color-muted);
  }

  .po-ledger-dot {
    color: rgba(242, 242, 242, 0.4);
  }

  .section-title {
    color: var(--color-ivory);
  }

  /* ------------------------------------------------------------------
     AI AGENTS — one constant, three variables
     ------------------------------------------------------------------ */

  .agents-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.66fr) minmax(0, 1fr);
    column-gap: clamp(32px, 6vw, 104px);
    align-items: start;
  }

  /* Deliberately not sticky: the ledger is only ~200px taller than this
     column, so pinning it would hold for a fraction of a scroll and then
     duck under the header — a half-committed gesture. The scale contrast
     between the constant and the three variables carries the idea on its
     own. */

  /* Undersized on purpose: this heading introduces the figure, it doesn't
     compete with it. */
  .agents-title {
    font-size: clamp(1.45rem, 2.3vw, 2.05rem);
    line-height: 1.14;
  }

  .agents-constant {
    margin-top: clamp(28px, 3.4vw, 52px);
    padding-bottom: clamp(14px, 1.6vw, 22px);
    border-bottom: 1px solid rgba(242, 242, 242, 0.3);
  }

  .agents-constant-fig {
    display: block;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: clamp(3rem, 7vw, 6.2rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
    color: var(--color-amber);
  }

  .agents-constant-unit {
    display: block;
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-steel);
  }

  .agent-line {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
    padding: clamp(20px, 2.4vw, 30px) 0;
    border-top: 1px solid var(--color-line);
  }

  .agent-line:last-child {
    border-bottom: 1px solid var(--color-line);
  }

  .agent-line-name h3 {
    font-family: var(--font-display);
    font-size: clamp(18px, 1.7vw, 22px);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-ivory);
  }

  .agent-line-name p {
    margin-top: 3px;
    font-size: 14px;
    line-height: 1.55;
    color: var(--color-muted);
  }

  .agent-line-figure {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
  }

  .agent-line-value {
    font-family: var(--font-mono);
    font-size: clamp(18px, 1.85vw, 25px);
    font-weight: 600;
    letter-spacing: -0.02em;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    color: var(--color-ivory);
  }

  .agent-line-unit {
    margin-top: 3px;
    font-size: 11.5px;
    letter-spacing: 0.02em;
    color: var(--color-muted);
  }

  .pricing-note {
    margin-top: var(--space-4);
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-muted);
    max-width: 56ch;
  }

  .pricing-note a {
    color: var(--color-amber);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .pricing-note a:hover,
  .pricing-note a:focus-visible {
    color: var(--color-ivory);
  }

  /* ------------------------------------------------------------------
     THE CUT — the diagonal break between the two halves of the page
     ------------------------------------------------------------------ */

  /* The wedge and the hairline are drawn from the same corner-to-corner
     geometry — polygon(0 100%, 100% 0, 100% 100%) and the 50% stop of a
     `to bottom right` gradient are the same line at every viewport width,
     so the lit plane's leading edge and the light on it stay collinear
     without a hardcoded angle that would drift as the frame changes. */
  .cut {
    position: relative;
    height: clamp(76px, 8.5vw, 140px);
    overflow: hidden;
    pointer-events: none;
  }

  .cut-plane,
  .cut-line,
  .cut-haze {
    position: absolute;
    inset: 0;
    display: block;
  }

  .cut-plane {
    background: rgba(255, 255, 255, 0.055);
    clip-path: polygon(0 100%, 100% 0, 100% 100%);
  }

  .cut-line {
    background: linear-gradient(
      to bottom right,
      transparent calc(50% - 0.5px),
      rgba(255, 255, 255, 0.95) calc(50% - 0.5px),
      rgba(255, 255, 255, 0.95) calc(50% + 0.5px),
      transparent calc(50% + 0.5px)
    );
    -webkit-mask-image: linear-gradient(90deg, transparent, rgba(0, 0, 0, 0.3) 10%, #000 62%, rgba(0, 0, 0, 0.35) 90%, transparent);
    mask-image: linear-gradient(90deg, transparent, rgba(0, 0, 0, 0.3) 10%, #000 62%, rgba(0, 0, 0, 0.35) 90%, transparent);
  }

  .cut-haze {
    background: radial-gradient(ellipse 22% 62% at 62% 38%, rgba(255, 255, 255, 0.22), transparent 72%);
    filter: blur(9px);
  }

  /* ------------------------------------------------------------------
     WEBSITE — the right rail, on the lit plane
     ------------------------------------------------------------------ */

  /* The plan and the care beneath it share one continuous surface — the
     floor the cut above opened onto — with no divider between them. */
  .website-pricing {
    padding-top: var(--space-6);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.055), rgba(255, 255, 255, 0.018) 72%, rgba(255, 255, 255, 0.012));
  }

  .care-plans {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.012), rgba(255, 255, 255, 0) 68%);
  }

  /* Pushed hard right, so the empty half of the frame is as much a part of
     the composition as the block is. */
  .website-rail {
    width: min(100%, 760px);
    margin-left: auto;
  }

  .website-head {
    max-width: none;
    margin-bottom: var(--space-5);
  }

  .website-head .section-title {
    font-size: clamp(1.9rem, 3.6vw, 3.1rem);
  }

  /* Website — one plain block, not a card: tagline, figures, scope list,
     one CTA. Same hairline-rule language as the agent ledger above it. */
  .price-block {
    padding-top: var(--space-4);
    border-top: 1px solid rgba(242, 242, 242, 0.22);
  }

  .price-block-tagline {
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-muted);
  }

  /* Not a matched pair either: the one-time figure leads at nearly twice
     the monthly's scale, in the order someone actually pays them. */
  .price-block-figures {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3) clamp(32px, 5vw, 72px);
    margin-top: var(--space-4);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }

  .price-figure {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .price-figure-value {
    font-family: var(--font-mono);
    font-size: clamp(1.35rem, 2.2vw, 1.85rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--color-steel);
  }

  .price-figure--lead .price-figure-value {
    font-size: clamp(2.4rem, 4.6vw, 3.8rem);
    letter-spacing: -0.035em;
    color: var(--color-ivory);
  }

  .price-figure-unit {
    margin-top: var(--space-1);
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--color-muted);
  }

  .price-figure--lead .price-figure-unit {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-steel);
  }

  /* A ruled spec column, not a two-up checklist — it gives the rail the
     vertical mass it needs to hold its own against the empty field beside
     it. */
  .price-block-scope {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .price-block-scope li {
    position: relative;
    padding: 11px 0 11px 22px;
    border-bottom: 1px solid var(--color-line);
    font-size: 15px;
    line-height: 1.55;
    color: var(--color-muted);
  }

  .price-block-scope li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 20px;
    width: 10px;
    height: 1px;
    background: var(--color-steel);
  }

  .price-block .btn {
    margin-top: var(--space-5);
  }

  /* ------------------------------------------------------------------
     WHAT'S COVERED — the underside, weighted left
     ------------------------------------------------------------------ */

  .care-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.92fr);
    column-gap: clamp(32px, 5vw, 88px);
    row-gap: var(--space-4);
    align-items: start;
  }

  .care-head {
    max-width: 400px;
  }

  .care-head .section-title {
    font-size: clamp(1.75rem, 3.2vw, 2.8rem);
  }

  /* Care list — same plain, unboxed treatment. */
  .care-list {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .care-list li {
    position: relative;
    padding-left: 20px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .care-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 9px;
    width: 8px;
    height: 1px;
    background: var(--color-steel);
  }

  .care-overflow {
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-line);
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-muted);
  }

  /* ------------------------------------------------------------------
     MARGINALIA — the two small-print items, offset right
     ------------------------------------------------------------------ */

  /* The one rule on the page weighted to the left, against the hero
     horizon's right-weighted one — no two boundaries on this page are
     the same shape. */
  .pricing-margin::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: min(54%, 640px);
    height: 1px;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.5), transparent);
  }

  .margin-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.68fr);
    column-gap: clamp(32px, 5vw, 80px);
    row-gap: var(--space-4);
    align-items: start;
    width: min(100%, 980px);
    margin-left: auto;
  }

  .margin-label {
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-steel);
  }

  .margin-title {
    margin-top: var(--space-2);
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 1.8vw, 1.5rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-ivory);
  }

  /* Breakdown placeholder — same dashed-border "flagged, not faked"
     language as What We Do's chat placeholder. Real figures needed before
     this becomes a real itemized table. */
  .breakdown-placeholder {
    margin-top: var(--space-3);
    padding: var(--space-3);
    border: 1px dashed rgba(242, 242, 242, 0.24);
    border-radius: var(--radius-md);
  }

  .breakdown-placeholder p {
    font-size: 14px;
    line-height: 1.65;
    color: var(--color-muted);
  }

  .breakdown-flag {
    display: none;
  }

  .content-footnote-text {
    font-size: 14px;
    line-height: 1.65;
    color: var(--color-muted);
  }

  /* ------------------------------------------------------------------
     FAQ — an offset column against a single falling spine
     ------------------------------------------------------------------ */

  .faq-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.5fr) minmax(0, 1fr);
    column-gap: clamp(32px, 6vw, 104px);
    row-gap: var(--space-4);
    align-items: start;
  }

  .faq-head {
    max-width: none;
  }

  .faq-head .section-title {
    font-size: clamp(1.6rem, 2.6vw, 2.35rem);
  }

  /* FAQ — already unboxed (native <details>, MeridianRule dividers); the
     list is narrower than its column and pushed to the right edge of it,
     against a vertical hairline that brightens as it falls. */
  .faq-list {
    position: relative;
    max-width: 660px;
    margin-left: auto;
    padding-left: clamp(20px, 3vw, 46px);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .faq-list::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 1px;
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.06),
      rgba(255, 255, 255, 0.3) 62%,
      rgba(255, 255, 255, 0.85)
    );
    pointer-events: none;
  }

  .faq-item {
    padding: 0;
  }

  .faq-divider {
    margin: 0;
  }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3) 0;
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-ivory);
    cursor: pointer;
    list-style: none;
    transition: color var(--transition-fast);
  }

  .faq-item[open] .faq-question {
    color: var(--color-steel);
  }

  .faq-question:focus-visible {
    outline: 2px solid var(--color-steel);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-icon {
    position: relative;
    flex-shrink: 0;
    width: 20px;
    height: 20px;
  }

  .faq-icon::before,
  .faq-icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    background: var(--color-steel);
    transform: translate(-50%, -50%);
    transition: transform var(--transition-fast);
  }

  .faq-icon::before {
    width: 12px;
    height: 2px;
  }

  .faq-icon::after {
    width: 2px;
    height: 12px;
  }

  .faq-item[open] .faq-icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .faq-answer {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s var(--ease-out);
  }

  .faq-answer.is-open {
    grid-template-rows: 1fr;
  }

  .faq-answer-inner {
    overflow: hidden;
  }

  .faq-answer-inner p {
    padding: 0 0 var(--space-4);
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-muted);
  }

  /* Closing CTA — same graphite-to-black gradient every closing band on
     the site now shares. */
  .pricing-cta {
    background:
      radial-gradient(ellipse 60% 80% at 85% 0%, rgba(216, 216, 216, 0.08), transparent 60%),
      linear-gradient(135deg, #3A3A3A 0%, #050505 100%);
  }

  .pricing-cta .btn {
    margin-top: var(--space-4);
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-answer {
      transition: none !important;
    }
  }

  /* ------------------------------------------------------------------
     Responsive — the geometry simplifies, it doesn't just shrink
     ------------------------------------------------------------------ */

  @media (max-width: 1040px) {
    .po-upper {
      grid-template-columns: minmax(0, 0.34fr) minmax(0, 1fr);
    }

    .agents-grid {
      grid-template-columns: minmax(0, 0.78fr) minmax(0, 1fr);
    }
  }

  @media (max-width: 900px) {
    /* The opening collapses to a single left rail — the monument is still
       three times the satellite and still the only lit thing, it just no
       longer sits across the frame from it. */
    .po-upper {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'head'
        'monument'
        'sat';
      row-gap: var(--space-5);
      align-items: start;
    }

    .po-monument {
      justify-self: start;
      margin-right: 0;
      text-align: left;
    }

    .po-satellite {
      align-self: start;
      padding-bottom: 0;
      padding-top: clamp(20px, 5vw, 36px);
      border-top: 1px solid var(--color-line);
    }

    .po-floor-grid,
    .care-grid,
    .margin-grid,
    .faq-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .care-head {
      max-width: none;
    }

    .margin-grid {
      width: 100%;
    }

    /* The anchor simply sits above its ledger — the constant still reads
       first, and still at figure scale. */
    .agents-grid {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--space-5);
    }

    .agents-title {
      max-width: 20ch;
    }

    .website-rail {
      width: 100%;
    }

    .faq-list {
      max-width: none;
      margin-left: 0;
      padding-left: 0;
    }

    .faq-list::before {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .pricing-open {
      padding-top: var(--space-5);
    }

    .po-upper {
      padding-bottom: clamp(36px, 11vw, 56px);
    }

    .po-mon-value {
      font-size: clamp(3.4rem, 21vw, 6rem);
    }

    .po-sat-value {
      font-size: clamp(1.7rem, 8.5vw, 2.4rem);
    }

    .agents-constant-fig {
      font-size: clamp(2.6rem, 17vw, 4.4rem);
    }

    /* Name over figure, the monthly still the largest thing in the row. */
    .agent-line {
      grid-template-columns: minmax(0, 1fr);
    }

    .agent-line-figure {
      align-items: flex-start;
      text-align: left;
    }

    .price-block-figures {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
    }

    .po-ledger-row {
      grid-template-columns: minmax(0, 1fr);
    }

    .po-ledger dd {
      font-size: 12.5px;
    }
  }
</style>

<script>
  document.querySelectorAll('.faq-item').forEach((item) => {
    const answer = item.querySelector('.faq-answer');
    if (!(answer instanceof HTMLElement) || !(item instanceof HTMLDetailsElement)) return;

    const syncOpenState = () => {
      answer.classList.toggle('is-open', item.open);
    };

    syncOpenState();
    item.addEventListener('toggle', syncOpenState);
  });
</script>
