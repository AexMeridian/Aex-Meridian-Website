      height: 160px;
    }

  }
</style>

<script>
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const isCoarsePointer = window.matchMedia('(pointer: coarse)').matches || 'ontouchstart' in window;

  // Cursor-reactive 3D tilt on each profile row — skipped on touch devices
  // and when reduced motion is requested.
  if (!prefersReducedMotion && !isCoarsePointer) {
    document.querySelectorAll('.profile-row').forEach((row) => {
      if (!(row instanceof HTMLElement)) return;

      const TILT_MAX = 4; // degrees — subtle, not a gimmick

      let ticking = false;
      let lastEvent: MouseEvent | null = null;

      const applyTilt = () => {
        if (!lastEvent) return;
        const rect = row.getBoundingClientRect();
        const px = (lastEvent.clientX - rect.left) / rect.width - 0.5;
        const py = (lastEvent.clientY - rect.top) / rect.height - 0.5;
        row.style.transform = `perspective(900px) rotateX(${(-py * TILT_MAX).toFixed(2)}deg) rotateY(${(px * TILT_MAX).toFixed(2)}deg)`;
        ticking = false;
      };

      row.addEventListener(
        'mousemove',
        (event) => {
          lastEvent = event;
          if (!ticking) {
            window.requestAnimationFrame(applyTilt);
            ticking = true;
          }
        },
        { passive: true }
      );

      row.addEventListener('mouseleave', () => {
        row.style.transform = '';
      });
    });
  }
</script>
