---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';
import WorkGrid from '../components/WorkGrid.astro';
import DeviceFrame from '../components/DeviceFrame.astro';
import MeridianRule from '../components/MeridianRule.astro';
import PageHero from '../components/PageHero.astro';
import { contactEmail, contactPhoneDisplay, contactPhoneHref, contactPhoneSmsHref } from '../data/site';

const workflow = [
  {
    title: 'Gather',
    day: 'Day 1',
    description: 'You send photos, key details, and any branding — takes minutes, not a meeting.',
  },
  {
    title: 'Draft',
    day: 'Days 2–4',
    description: 'We build a first pass around what you gave us.',
  },
  {
    title: 'Review',
    day: 'Day 5',
    description: 'Every draft is checked for accuracy and brand fit before you ever see it.',
  },
  {
    title: 'Deliver',
    day: 'Within a week',
    description: 'Ready-to-post files, branded to your business. Nothing publishes without your sign-off.',
  },
];

const included = [
  'Mobile-responsive on every screen size',
  'Contact form that actually delivers',
  'Basic on-page SEO',
  'Fast load times',
  'SSL and security',
  'Accessible markup (WCAG 2.1 AA basics)',
  'Hosting and DNS handled',
  'Ongoing edits without logging into anything',
];

const profiles = [
  {
    slug: 'trades',
    star: 'Trades',
    title: 'Trades and home services',
    body: 'Contractors, electricians, plumbers, and landscapers compete on trust before they compete on price. A site that shows real work, a clear service area, and an easy way to request a quote does some of the selling before the phone ever rings.',
    benefits: [
      'A gallery built to showcase past jobs',
      'Service-area and quote-request pages that cut down back-and-forth',
      "Best agent fit: AI Voice Receptionist — answers the phone when you're mid-job",
    ],
    icon: '<path d="M11.414 10l-7.383 7.418a2.091 2.091 0 0 0 0 2.967a2.11 2.11 0 0 0 2.976 0l7.407 -7.385" /><path d="M18.121 15.293l2.586 -2.586a1 1 0 0 0 0 -1.414l-7.586 -7.586a1 1 0 0 0 -1.414 0l-2.586 2.586a1 1 0 0 0 0 1.414l7.586 7.586a1 1 0 0 0 1.414 0" />',
  },
  {
    slug: 'realtors',
    star: 'Realtors & hosts',
    title: 'Realtors, property managers & short-term rental hosts',
    body: "A listing lives or dies on how it looks online. We build the site that houses your listings and produce the walkthrough videos that make them stand out — a professional tour ready in days, not weeks, without hiring a videographer.",
    benefits: [
      'Listing tours with voiceover, music, and text overlays, delivered ready to post',
      'Formats built for listing sites and Reels/Stories alike',
      'Best agent fit: AI Voice Receptionist — captures inbound inquiries after hours',
    ],
    icon: '<path d="M5 12l-2 0l9 -9l9 9l-2 0" /><path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-7" /><path d="M9 21v-6a2 2 0 0 1 2 -2h2a2 2 0 0 1 2 2v6" />',
  },
  {
    slug: 'consultants',
    star: 'Consultants',
    title: 'Consultants and professional services',
    body: 'Coaches, agents, bookkeepers, and small practices sell expertise, and expertise needs to look credible online before a prospect ever picks up the phone. We build sites that lead with credentials and services, with a simple way to get in touch.',
    benefits: [
      'Clear service and credential pages, no clutter',
      'A contact flow built for booking a first conversation',
      'Best agent fit: Website Chat Agent — handles intake and qualifies visitors automatically',
    ],
    icon: '<path d="M3 9a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v9a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2l0 -9" /><path d="M8 7v-2a2 2 0 0 1 2 -2h4a2 2 0 0 1 2 2v2" /><path d="M12 12l0 .01" /><path d="M3 13a20 20 0 0 0 18 0" />',
  },
  {
    slug: 'wellness',
    star: 'Wellness',
    title: 'Personal care and wellness',
    body: 'Trainers, therapists, and stylists need clients to find hours, services, and contact info fast, without an online booking system to manage or a monthly software fee to pay for. We keep it simple: a site that answers the questions people actually ask.',
    benefits: [
      'Hours, services, and contact info, always current',
      'No booking-software subscription required',
      'Best agent fit: AI Voice Receptionist — bookings and appointment reminders',
    ],
    icon: '<path d="M19.5 12.572l-7.5 7.428l-7.5 -7.428a5 5 0 1 1 7.5 -6.566a5 5 0 1 1 7.5 6.572" />',
  },
  {
    slug: 'retail',
    star: 'Retail',
    title: 'Local shops and retail',
    body: "Boutiques, bakeries, and florists live on foot traffic and word of mouth — a site's job is to get someone in the door. We build sites that lead with location, hours, and what makes the trip worth it, plus social content that keeps the shop visible between visits.",
    benefits: [
      'Hours and location front and center',
      'A look that matches the in-store experience',
      'Best agent fit: Website Chat Agent — answers hours and stock questions instantly',
    ],
    icon: '<path d="M6.331 8h11.339a2 2 0 0 1 1.977 2.304l-1.255 8.152a3 3 0 0 1 -2.966 2.544h-6.852a3 3 0 0 1 -2.965 -2.544l-1.255 -8.152a2 2 0 0 1 1.977 -2.304" /><path d="M9 11v-5a3 3 0 0 1 6 0v5" />',
  },
];

// Fixed sky positions (percent of the hero) for the constellation nodes —
// spread through the open sky, away from the aurora's brightest band
// and out of the text column on the left.
const starPositions = [
  { x: 60, y: 20 },
  { x: 83, y: 40 },
  { x: 70, y: 66 },
  { x: 46, y: 80 },
  { x: 24, y: 62 },
];

// One-file drop-in: swap in a real photo at public/images/founder.jpg and
// this switches from the monogram automatically — no code change needed.
const founderPhotoExists = fs.existsSync(path.join(process.cwd(), 'public/images/founder.jpg'));
---

<Layout
  title="How It Works — Aex Meridian"
  description="How a project actually runs, what's included in every build, and who Aex Meridian builds for — real client profiles and the process behind them."
>
  <Header contactHref="#contact" />
  <main id="main-content">
    <PageHero
      video="/videos/our-work-bg.mp4"
      videoId="ow-hero-loop"
      eyebrow="How it works"
      title="Built for real local businesses, not enterprise accounts"
      subhead="Every project starts the same way, whether it's a site, an AI agent, or a listing video: I build the real thing first. You see exactly what you're getting before any money changes hands. Here's how that works, and who it works for."
    >
      <!-- The five client categories, plotted as a constellation over the
           aurora sky instead of a plain chip row — each star links straight
           to its profile below. -->
      <nav slot="overlay" class="constellation" aria-label="Who we build for">
        <svg
          class="constellation-lines"
          viewBox="0 0 100 100"
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          <polyline
            points={starPositions.map((p) => `${p.x},${p.y}`).join(' ')}
            fill="none"
          />
        </svg>
        {profiles.map((profile, i) => (
          <a
            href={`#profile-${profile.slug}`}
            class="star-node"
            style={`--x:${starPositions[i].x}%; --y:${starPositions[i].y}%; --delay:${i * 0.4}s;`}
          >
            <span class="star-dot" aria-hidden="true"></span>
            <span class="star-label">{profile.star}</span>
          </a>
        ))}
      </nav>

      <div slot="actions" class="page-hero-actions">
        <a href="#contact" class="btn btn-primary btn-shimmer" data-magnetic>
          <span>Book a free consultation</span>
          <span class="btn-arrow">&rarr;</span>
        </a>
        <a href="/what-we-do" class="btn btn-ghost btn-shimmer" data-magnetic>
          <span>See what we do</span>
        </a>
      </div>
    </PageHero>

    <section class="section process seam mode-dark-bleed mode-glow" id="process">
      <div class="container">
        <div class="section-head" data-reveal>
          <p class="eyebrow">The process</p>
          <h2 class="section-title">From first email to the finished thing</h2>
        </div>

        <!-- The course line — a plotted route with a waypoint per stage,
             standing in for a generic four-column grid. "Aex Meridian" is
             itself a navigation term (a meridian is a line used to chart a
             course); this is that idea made literal for the one section on
             the site that's genuinely sequential. -->
        <div class="course-line" data-reveal>
          {workflow.map((step) => (
            <div class="course-stop">
              <span class="course-stop-marker" aria-hidden="true"></span>
              <span class="course-stop-day">{step.day}</span>
              <h3 class="course-stop-title">{step.title}</h3>
              <p class="course-stop-desc">{step.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section included seam">
      <div class="container">
        <div class="section-head" data-reveal>
          <p class="eyebrow">Every website</p>
          <h2 class="section-title">What's included, no exceptions</h2>
        </div>

        <ul class="manifest-list" data-reveal-stagger>
          {included.map((item, i) => (
            <li class="manifest-item" data-reveal>
              <span class="manifest-index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="manifest-text">{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section profiles seam mode-dark-bleed">
      <video class="profiles-video" data-src="/videos/starfield-horizon.mp4" muted playsinline loop preload="none" aria-hidden="true"></video>
      <div class="container">
        <div class="section-head" data-reveal>
          <p class="eyebrow">Who we build for</p>
          <h2 class="section-title">Five kinds of businesses we know well</h2>
        </div>

        <div class="profile-list" data-reveal-stagger>
          {profiles.map((profile, i) => (
            <div
              id={`profile-${profile.slug}`}
              class:list={['profile-row', i % 2 === 1 && 'profile-row--reverse']}
              data-reveal
            >
              <div class:list={['profile-visual', `profile-visual--${['teal', 'steel', 'amber'][i % 3]}`]} aria-hidden="true">
                <span class="profile-visual-word">{profile.star}</span>
              </div>
              <div class="profile-copy">
                <span class="profile-tag">{profile.star}</span>
                <h3 class="profile-title">{profile.title}</h3>
                <p class="profile-body">{profile.body}</p>
                <ul class="profile-benefits">
                  {profile.benefits.map((item) => <li>{item}</li>)}
                </ul>
              </div>
            </div>
          ))}
        </div>

        <div class="profiles-fallback" data-reveal>
          <p class="profiles-fallback-text">
            Not one of these five? They're the businesses we see most, not the only ones
            we take on — <a href="#contact">get in touch</a> and we'll tell you honestly
            if we're a fit.
          </p>
        </div>
      </div>
    </section>

    <section class="section device-showcase mode-dark-bleed">
      <div class="device-showcase-texture" data-scroll-drift="24" aria-hidden="true"></div>
      <div class="container">
        <div class="section-head" data-reveal>
          <p class="eyebrow">See it for yourself</p>
          <h2 class="section-title">The site you're looking at, on any screen</h2>
        </div>

        <div class="device-showcase-frames" data-reveal>
          <DeviceFrame
            device="laptop"
            image="home-laptop.webp"
            alt="The Aex Meridian homepage shown on a laptop screen"
            class="device-showcase-laptop"
          />
          <DeviceFrame
            device="phone"
            image="pricing-phone.webp"
            alt="The Aex Meridian pricing page shown on a phone screen"
            class="device-showcase-phone"
          />
        </div>
      </div>
    </section>

    <WorkGrid />

    <section class="section founder seam mode-dark-bleed mode-glow" id="founder">
      <div class="container founder-grid">
        <div class="founder-portrait" data-reveal>
          {founderPhotoExists ? (
            <img src="/images/founder.jpg" alt="Caleb Aex, founder of Aex Meridian" class="founder-photo" width="480" height="480" loading="lazy" />
          ) : (
            <div class="founder-monogram" role="img" aria-label="Caleb Aex, founder of Aex Meridian">AM</div>
          )}
        </div>

        <div class="founder-copy" data-reveal>
          <p class="eyebrow">The founder</p>
          <h2 class="founder-name">Caleb Aex, founder</h2>
          <p class="founder-body">
            Aex Meridian is intentionally small — just one person. No account managers,
            no handoffs, no ticket queue. When you call, you get the person who
            actually built your site.
          </p>
          <p class="founder-body">
            That's the whole model. Small roster, direct line, work that gets done
            because there's no one else to hand it to. First response within one
            business day.
          </p>
          <p class="founder-contact">
            <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
            <span aria-hidden="true"> &middot; </span>
            <a href={contactPhoneHref}>{contactPhoneDisplay}</a>
            <span aria-hidden="true"> &middot; </span>
            <a href={contactPhoneSmsHref}>Text</a>
          </p>
        </div>
      </div>
    </section>

    <section class="section ow-cta cta-band">
      <video class="cta-band-video" data-src="/videos/cta-depth.mp4" muted playsinline loop preload="none" aria-hidden="true"></video>
      <div class="container ow-cta-inner cta-band-inner" data-reveal>
        <MeridianRule dot="none" align="left" class="cta-rule" />
        <h2 class="cta-heading">Think we're a fit?</h2>
        <p class="cta-sub">Tell us about your business — we'll tell you honestly if we can help.</p>
        <p class="cta-guarantee">You see it work before you pay a dollar.</p>
        <a href="#contact" class="btn btn-primary btn-shimmer" data-magnetic>
          <span>Book a free consultation</span>
          <span class="btn-arrow">&rarr;</span>
        </a>
      </div>
    </section>
    <ContactForm />
  </main>
  <Footer contactHref="#contact" />
</Layout>

<style>
  /* Constellation nav — the five client categories plotted over the sky.
     Sits above the video/scrim but below the text column's own
     z-index, and only the star links themselves capture pointer events. */
  .constellation {
    position: absolute;
    inset: 0;
    z-index: 5;
    pointer-events: none;
  }

  .constellation-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .constellation-lines polyline {
    stroke: rgba(247, 245, 240, 0.25);
    stroke-width: 0.15;
    stroke-dasharray: 0.6 1;
    vector-effect: non-scaling-stroke;
  }

  .star-node {
    position: absolute;
    left: var(--x);
    top: var(--y);
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 12px;
    pointer-events: auto;
    text-decoration: none;
  }

  .star-dot {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-ivory);
    box-shadow: 0 0 8px 2px rgba(247, 245, 240, 0.75), 0 0 20px 6px rgba(107, 135, 168, 0.5);
    transition: var(--transition-fast);
  }

  .star-dot::after {
    content: '';
    position: absolute;
    inset: -7px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(247, 245, 240, 0.4), transparent 70%);
    opacity: 0;
    animation: star-pulse 3.6s ease-in-out infinite;
    animation-delay: var(--delay);
  }

  .star-label {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: rgba(247, 245, 240, 0.8);
    white-space: nowrap;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.7);
    opacity: 0;
    transform: translateY(-4px);
    transition: var(--transition-fast);
  }

  .star-node:hover .star-label,
  .star-node:focus-visible .star-label {
    opacity: 1;
    transform: translateY(0);
  }

  .star-node:hover .star-dot,
  .star-node:focus-visible .star-dot {
    transform: scale(1.7);
    box-shadow: 0 0 10px 3px rgba(247, 245, 240, 1), 0 0 28px 10px rgba(107, 135, 168, 0.85);
  }

  .star-node:focus-visible {
    outline: none;
  }

  .star-node:focus-visible .star-dot {
    outline: 2px solid var(--color-ivory);
    outline-offset: 5px;
  }

  @keyframes star-pulse {
    0%,
    100% {
      opacity: 0;
      transform: scale(0.6);
    }
    50% {
      opacity: 1;
      transform: scale(1.7);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .star-dot::after {
      animation: none;
    }
  }

  /* Small screens: star labels can't meet a 44px touch target and the
     scattered layout gets cramped, so the constellation steps aside —
     the "Five kinds of businesses" section right below covers the same
     ground linearly. */
  @media (max-width: 760px) {
    .constellation {
      display: none;
    }
  }


  .section-title {
    color: var(--color-ivory);
  }

  /* Sits directly under the hero, still on navy — without its own mark
     this section would bleed into the hero above with no seam at all,
     which is the exact "one continuous hero" problem this page had. A
     faint chart of concentric rings (a course plotted from a fixed point,
     literal for a page whose signature motif is already a plotted route)
     reads as a document surface, not a scene, the moment the fold ends. */
  .process {
    position: relative;
    background-image: repeating-radial-gradient(
      circle at 12% 8%,
      rgba(var(--color-amber-rgb), 0.05) 0px,
      rgba(var(--color-amber-rgb), 0.05) 1px,
      transparent 1px,
      transparent 84px
    );
  }

  /* The process — now this page's primary content, not a teaser. Concrete
     day-ranges are the substitute for portfolio proof: specificity reads
     as more credible than a vague "fast turnaround" claim. Plotted as a
     course line rather than a four-column grid or a scroll-scrubbed pin —
     a dashed route with a diamond waypoint per stage, reading top to
     bottom like an actual log instead of a slideshow the scrollbar has to
     fight through. */
  .course-line {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    max-width: 640px;
    padding-left: 4px;
  }

  .course-line::before {
    content: '';
    position: absolute;
    left: 9px;
    top: 8px;
    bottom: 8px;
    border-left: 2px dashed rgba(var(--color-amber-rgb), 0.5);
  }

  .course-stop {
    position: relative;
    padding-left: 40px;
  }

  .course-stop-marker {
    position: absolute;
    left: 3px;
    top: 6px;
    width: 13px;
    height: 13px;
    background: var(--color-amber);
    transform: rotate(45deg);
    box-shadow: 0 0 0 4px var(--color-navy), 0 0 14px rgba(var(--color-amber-rgb), 0.5);
  }

  .course-stop-day {
    display: inline-block;
    margin-bottom: 4px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
    color: var(--color-amber);
  }

  .course-stop-title {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-ivory);
    margin-bottom: 6px;
  }

  .course-stop-desc {
    font-size: 15px;
    line-height: 1.65;
    color: var(--color-muted);
    max-width: 46ch;
  }

  /* First hard seam on the page — a genuine light break right after the
     process section, instead of navy running unbroken from the hero to
     the footer. Same paper register Pricing uses, borrowed for one
     section rather than a whole page. */
  .included {
    background: var(--color-ivory);
    color: var(--color-ink);
  }

  .included .eyebrow {
    color: var(--color-steel-on-light);
  }

  .included .section-title {
    color: var(--color-ink);
  }

  /* A manifest, not a checklist — tabular index numbers instead of a
     checkmark-in-a-circle for every row, which is the site's own rule
     against slot-filler icons applied to itself. Two columns use the
     width instead of leaving half the section empty. */
  .manifest-list {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 920px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    column-gap: var(--space-6);
  }

  .manifest-item {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-line-on-light);
  }

  .manifest-index {
    flex-shrink: 0;
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
    color: var(--color-teal);
  }

  .manifest-text {
    font-size: 18px;
    font-weight: 500;
    color: var(--color-ink);
  }

  @media (max-width: 640px) {
    .manifest-list {
      grid-template-columns: 1fr;
    }

    .manifest-text {
      font-size: 16px;
    }
  }

  /* Client profiles — flipped to dark (from white) to break up the page's
     longest light stretch; the profile-visual tiles already gradient into
     navy, so putting the whole section on navy turns that into a real
     environment instead of tiles floating on a white card. */
  .profiles {
    position: relative;
    overflow: hidden;
    background: var(--color-navy);
    color: var(--color-ivory);
  }

  /* Echoes the constellation nav up in the hero — a starfield horizon
     bleeding faintly under the same five profiles it linked down to,
     kept quiet enough to read as depth rather than a second scene. */
  .profiles-video {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    opacity: 0.22;
    filter: saturate(0.6) brightness(0.85);
    pointer-events: none;
  }

  .profiles > .container {
    position: relative;
    z-index: 1;
  }

  .profiles .eyebrow {
    color: var(--color-steel);
  }

  .profiles .section-title {
    color: var(--color-ivory);
  }

  @media (prefers-reduced-motion: reduce) {
    .profiles-video {
      display: none;
    }
  }

  /* A real callout, not a muted afterthought — this list reads as
     definitive ("five kinds of businesses") right up until this box says
     otherwise, so it needs actual visual weight to correct that impression. */
  .profiles-fallback {
    margin-top: var(--space-6);
    padding: var(--space-4) var(--space-5);
    text-align: center;
    background: rgba(61, 107, 107, 0.12);
    border: 1px solid rgba(107, 135, 168, 0.3);
    border-radius: var(--radius-md);
  }

  .profiles-fallback-text {
    font-size: 17px;
    line-height: 1.6;
    font-weight: 500;
    color: var(--color-ivory);
    max-width: 56ch;
    margin: 0 auto;
  }

  .profiles-fallback-text a {
    color: var(--color-steel);
    text-decoration: underline;
    text-underline-offset: 2px;
    font-weight: 600;
  }

  .profiles-fallback-text a:hover,
  .profiles-fallback-text a:focus-visible {
    color: var(--color-ivory);
  }

  /* Editorial, alternating rows — each of the five profiles gets a real
     destination feel (the constellation up in the hero promises five
     separate landings), but as a left/right layout rather than five
     identical stacked cards. The icon side carries a large ghosted
     numeral standing in for photography until real industry photos exist. */
  .profile-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
  }

  .profile-row {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: var(--space-6);
    align-items: center;
    scroll-margin-top: var(--header-height);
    transition: transform 0.2s ease-out;
    transform-style: preserve-3d;
  }

  .profile-row--reverse {
    grid-template-columns: 1fr 240px;
  }

  .profile-row--reverse .profile-visual {
    order: 2;
  }

  /* No icon, no badge — an icon-in-a-colored-box reads as a slot that
     needed filling, not a deliberate choice, and doesn't say anything a
     generic "services" page couldn't also say. The category name itself,
     set oversized in the display face and bleeding past its own edges,
     carries the row instead — cycling through the site's three accents
     (teal/steel/amber) so the five rows still read as five distinct
     tiles, not five copies of the same card. Purely decorative repeat of
     .profile-tag/.profile-title just below, so it's aria-hidden. */
  .profile-visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 200px;
    border-radius: var(--radius-lg);
    overflow: hidden;
