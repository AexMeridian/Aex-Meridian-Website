    letter-spacing: -0.02em;
    text-align: center;
    color: rgba(247, 245, 240, 0.92);
    padding: 0 var(--space-2);
  }

  /* Echoes the constellation star's own label back — confirmation that
     clicking that star landed you in the right place. */
  .profile-tag {
    display: block;
    margin-bottom: var(--space-2);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
