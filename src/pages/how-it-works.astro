  /* Device showcase — a real, self-referential proof: the site itself,
     framed on the two screens a visitor is most likely using right now.
     The aurora texture ties this dark-bleed section back to the same
     clip the page hero uses, at low enough opacity to read as ambient
     material rather than a second photo. */
  .device-showcase {
    position: relative;
    z-index: 2;
    overflow: visible;
    padding-bottom: calc(var(--space-7) + 60px);
  }

  /* Local overrides win the light-section defaults set earlier in this
     same stylesheet (same specificity, later source order) — this section
     needs the dark-background variants of both. */
  .device-showcase .eyebrow {
    color: var(--color-steel);
  }

  .device-showcase .section-title {
    color: var(--color-ivory);
  }

  .device-showcase-texture {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: url('/images/textures/aurora-mountains.webp');
    background-size: cover;
    background-position: center;
    opacity: 0.14;
    pointer-events: none;
  }

  .device-showcase .container {
    position: relative;
    z-index: 1;
  }

  .device-showcase-frames {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: var(--space-6);
    margin-top: var(--space-6);
  }

  /* Pulled down past this section's own bottom edge — the one deliberate
     container break on this page, per the visual-pass brief. */
  .device-showcase-phone {
    margin-bottom: -60px;
  }

  @media (max-width: 760px) {
    /* The -60px overlap is a desktop-only signature (device breaking past
       the section edge) — once it's neutralized below, the padding that
       existed to make room for it is dead weight too. */
    .device-showcase {
      padding-bottom: var(--space-7);
    }

    .device-showcase-frames {
      flex-direction: column;
      align-items: center;
    }

    /* Phone leads on mobile — it's the screen whoever's reading this is
       actually holding, so it makes the point before the laptop does. */
    .device-showcase-phone {
      order: -1;
      margin-bottom: 0;
    }

    .device-showcase-laptop {
      max-width: 360px;
    }
  }

  /* Video stats */
  .video-stats {
    background: var(--color-ivory);
    color: var(--color-ink);
  }

  .stats-rail {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  .stat-item {
    position: relative;
    padding: 0 var(--space-4);
  }

  .stat-item:not(:first-child)::before {
