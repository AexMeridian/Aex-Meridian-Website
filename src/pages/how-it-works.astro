  /* Founder */
  .founder {
    background: var(--color-ivory);
    color: var(--color-ink);
  }

  .founder-grid {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: var(--space-6);
    align-items: center;
  }

  .founder-portrait {
    width: 100%;
    aspect-ratio: 1;
  }

  .founder-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Source is a tall portrait with the face in the upper third — a
       centered crop into this square slot would cut the head off and
       center on the torso instead. Biasing toward the top keeps the face
       properly framed. */
    object-position: center 20%;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-line-on-light);
    box-shadow: var(--shadow-tinted-light);
  }

  .founder-monogram {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 64px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-amber);
    background: var(--color-white);
    border: 1px solid var(--color-line-on-light);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-tinted-light);
  }

  .founder-name {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.8vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin: var(--space-2) 0 var(--space-3);
  }

  .founder-body {
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-ink-muted);
    max-width: 60ch;
  }

  .founder-body + .founder-body {
    margin-top: var(--space-2);
  }

  .founder-contact {
    margin-top: var(--space-3);
    font-size: 15px;
    font-weight: 600;
  }

  .founder-contact a {
    color: var(--color-amber);
    text-decoration: none;
  }

  .founder-contact a:hover,
  .founder-contact a:focus-visible {
    color: var(--color-steel);
  }

  @media (max-width: 640px) {
    .founder-grid {
      grid-template-columns: 1fr;
    }

    .founder-portrait {
      max-width: 200px;
      margin: 0 auto;
    }
  }

  /* Closing CTA — amber into navy, carrying that same warm accent color
     through to the page's last moment, rather than the site's default
     teal-to-navy gradient used on the other pages' closing sections. */
  .ow-cta {
    background: linear-gradient(135deg, #3D6B6B 0%, #16232B 100%);
  }

  .ow-cta .btn {
    margin-top: var(--space-4);
  }

  @media (max-width: 640px) {
    .profile-row,
    .profile-row--reverse {
      grid-template-columns: 1fr;
    }

    .profile-row--reverse .profile-visual {
      order: 0;
    }

    .profile-visual {
      height: 160px;
    }

    .stats-rail {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .stat-item {
      padding: var(--space-4) 0 0;
    }

    .stat-item:not(:first-child)::before {
      left: 8px;
      right: 8px;
      top: 0;
      bottom: auto;
      width: auto;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--color-teal), transparent);
    }

    .stat-item:first-child {
      padding-top: 0;
    }
  }
</style>

<script>
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const isCoarsePointer = window.matchMedia('(pointer: coarse)').matches || 'ontouchstart' in window;

  // Timeline track draw-in, same pattern used on What We Do's workflow
  // section.
  const track = document.querySelector('.timeline-track');
  const steps = document.querySelectorAll('.timeline-step');

  if (prefersReducedMotion) {
    track?.classList.add('in-view');
    steps.forEach((step) => step.classList.add('in-view'));
  } else {
    const timelineObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view');
            timelineObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.3 }
    );
    if (track) timelineObserver.observe(track);
    steps.forEach((step) => timelineObserver.observe(step));
  }

  // Cursor-reactive 3D tilt on each profile row — skipped on touch devices
  // and when reduced motion is requested.
  if (!prefersReducedMotion && !isCoarsePointer) {
    document.querySelectorAll('.profile-row').forEach((row) => {
      if (!(row instanceof HTMLElement)) return;

      const TILT_MAX = 4; // degrees — subtle, not a gimmick

      row.addEventListener('mousemove', (event) => {
        const rect = row.getBoundingClientRect();
        const px = (event.clientX - rect.left) / rect.width - 0.5;
        const py = (event.clientY - rect.top) / rect.height - 0.5;
        row.style.transform = `perspective(900px) rotateX(${(-py * TILT_MAX).toFixed(2)}deg) rotateY(${(px * TILT_MAX).toFixed(2)}deg)`;
      });

      row.addEventListener('mouseleave', () => {
        row.style.transform = '';
      });
    });
  }
</script>
