  .profile-visual-number {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 600;
    color: rgba(247, 245, 240, 0.55);
  }

  /* Echoes the constellation star's own label back — confirmation that
     clicking that star landed you in the right place. */
  .profile-tag {
    display: block;
    margin-bottom: var(--space-2);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
