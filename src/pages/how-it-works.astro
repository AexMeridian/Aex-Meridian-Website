---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';
import WorkGrid from '../components/WorkGrid.astro';
import DeviceFrame from '../components/DeviceFrame.astro';
import MeridianRule from '../components/MeridianRule.astro';
import { contactEmail, contactPhoneDisplay, contactPhoneHref, contactPhoneSmsHref } from '../data/site';

const workflow = [
  {
    title: 'Gather',
    day: 'Day 1',
    description: 'You send photos, key details, and any branding — takes minutes, not a meeting.',
  },
  {
    title: 'Draft',
    day: 'Days 2–4',
    description: 'We build a first pass around what you gave us.',
  },
  {
    title: 'Review',
    day: 'Day 5',
    description: 'Every draft is checked for accuracy and brand fit before you ever see it.',
  },
  {
    title: 'Deliver',
    day: 'Within a week',
    description: 'Ready-to-post files, branded to your business. Nothing publishes without your sign-off.',
  },
];

const included = [
  'Mobile-responsive on every screen size',
  'Contact form that actually delivers',
  'Basic on-page SEO',
  'Fast load times',
  'SSL and security',
  'Accessible markup (WCAG 2.1 AA basics)',
  'Hosting and DNS handled',
  'Ongoing edits without logging into anything',
];

const profiles = [
  {
    slug: 'trades',
    star: 'Trades',
    title: 'Trades and home services',
    body: 'Contractors, electricians, plumbers, and landscapers compete on trust before they compete on price. A site that shows real work, a clear service area, and an easy way to request a quote does some of the selling before the phone ever rings.',
    benefits: [
      'A gallery built to showcase past jobs',
      'Service-area and quote-request pages that cut down back-and-forth',
      "Best agent fit: AI Voice Receptionist — answers the phone when you're mid-job",
    ],
  },
  {
    slug: 'realtors',
    star: 'Realtors & hosts',
    title: 'Realtors, property managers & short-term rental hosts',
    body: "A listing lives or dies on how it looks online. We build the site that houses your listings and produce the walkthrough videos that make them stand out — a professional tour ready in days, not weeks, without hiring a videographer.",
    benefits: [
      'Listing tours with voiceover, music, and text overlays, delivered ready to post',
      'Formats built for listing sites and Reels/Stories alike',
      'Best agent fit: AI Voice Receptionist — captures inbound inquiries after hours',
    ],
  },
  {
    slug: 'consultants',
    star: 'Consultants',
    title: 'Consultants and professional services',
    body: 'Coaches, agents, bookkeepers, and small practices sell expertise, and expertise needs to look credible online before a prospect ever picks up the phone. We build sites that lead with credentials and services, with a simple way to get in touch.',
    benefits: [
      'Clear service and credential pages, no clutter',
      'A contact flow built for booking a first conversation',
      'Best agent fit: Website Chat Agent — handles intake and qualifies visitors automatically',
    ],
  },
  {
    slug: 'wellness',
    star: 'Wellness',
    title: 'Personal care and wellness',
    body: 'Trainers, therapists, and stylists need clients to find hours, services, and contact info fast, without an online booking system to manage or a monthly software fee to pay for. We keep it simple: a site that answers the questions people actually ask.',
    benefits: [
      'Hours, services, and contact info, always current',
      'No booking-software subscription required',
      'Best agent fit: AI Voice Receptionist — bookings and appointment reminders',
    ],
  },
  {
    slug: 'retail',
    star: 'Retail',
    title: 'Local shops and retail',
    body: "Boutiques, bakeries, and florists live on foot traffic and word of mouth — a site's job is to get someone in the door. We build sites that lead with location, hours, and what makes the trip worth it, plus social content that keeps the shop visible between visits.",
    benefits: [
      'Hours and location front and center',
      'A look that matches the in-store experience',
      'Best agent fit: Website Chat Agent — answers hours and stock questions instantly',
    ],
  },
];

// The five profiles are not five equal citizens on this page any more: the
// first one carries the section as a single lit slab and the rest recede
// into a quieter column beside it. Splitting here keeps that structural
// decision visible in the data rather than buried in nth-child CSS.
const [leadProfile, ...minorProfiles] = profiles;

// One-file drop-in: swap in a real photo at public/images/founder.jpg and
// this switches from the monogram automatically — no code change needed.
const founderPhotoExists = fs.existsSync(path.join(process.cwd(), 'public/images/founder.jpg'));
---

<Layout
  title="How It Works — Aex Meridian"
  description="How a project actually runs, what's included in every build, and who Aex Meridian builds for — real client profiles and the process behind them."
>
  <Header contactHref="#contact" />
  <main id="main-content" class="hiw-page">
    <!-- Opening — an asymmetric split rather than one centered stack: the
         headline takes the wide left field at full sculptural scale, and
         the five-business index hangs off the right edge as a thin spec
         rail, dropped well below the headline's baseline so the two halves
         never read as a 50/50 grid. -->
    <div class="hiw-open">
      <MeridianRule dot="none" align="full" />
      <div class="container">
        <div class="hiw-open-grid">
          <div class="hiw-open-lead" data-reveal>
            <p class="eyebrow">How it works</p>
            <h1 class="hiw-title">Built for real local businesses, not enterprise accounts</h1>
            <p class="hiw-subhead">
              Every project starts the same way, whether it's a site, an AI agent, or a
              listing video: I build the real thing first. You see exactly what you're
              getting before any money changes hands. Here's how that works, and who
              it works for.
            </p>

            <div class="hiw-actions">
              <a href="#contact" class="btn btn-primary btn-shimmer" data-magnetic>
                <span>Get your free demo</span>
                <span class="btn-arrow">&rarr;</span>
              </a>
              <a href="/what-we-do" class="btn btn-ghost btn-shimmer" data-magnetic>
                <span>See what we do</span>
              </a>
            </div>
          </div>

          <nav class="hiw-ledger" aria-labelledby="hiw-ledger-label" data-reveal>
            <p class="hiw-ledger-label" id="hiw-ledger-label">Who we build for</p>
            {profiles.map((profile, i) => (
              <a href={`#profile-${profile.slug}`} class="hiw-ledger-row">
                <span class="hiw-ledger-number">{String(i + 1).padStart(2, '0')}</span>
                <span class="hiw-ledger-name">{profile.star}</span>
                <span class="hiw-ledger-arrow" aria-hidden="true">&rarr;</span>
              </a>
            ))}
          </nav>
        </div>
      </div>
    </div>

    <section class="section process" id="process">
      <div class="container">
        <div class="section-head process-head" data-reveal>
          <p class="eyebrow">The process</p>
          <h2 class="section-title">From first email to the finished thing</h2>
        </div>
      </div>

      <!-- The sweep. The reference photograph is one enormous form cutting
           diagonally across an otherwise empty field and landing on a lit
           horizon; this is that composition carrying the only genuinely
           sequential content on the site. Each stage steps further right
           than the last, a single brushed edge leans through all four, and
           the stages brighten as they go — the work coming out of the dark
           into full light, then meeting the floor. The section head is
           deliberately undersized so the stage words are the largest thing
           on the page, not the heading above them. -->
      <div class="sweep">
        <div class="sweep-inner">
          <span class="sweep-body" aria-hidden="true"></span>
          <span class="sweep-edge" aria-hidden="true"></span>

          <ol class="sweep-list" role="list" data-reveal-stagger>
            {workflow.map((step, i) => (
              <li class="sweep-step" style={`--i:${i}`} data-reveal>
                <span class="sweep-day">{step.day}</span>
                <h3 class="sweep-word">{step.title}</h3>
                <p class="sweep-desc">{step.description}</p>
              </li>
            ))}
          </ol>
        </div>

        <div class="sweep-horizon" aria-hidden="true"></div>
        <div class="sweep-floor" aria-hidden="true"></div>
      </div>
    </section>

    <!-- The one light surface on the page, and the only section that runs
         off the right edge of the frame: a lit plane entering from
         off-camera, with its heading held back in a narrow column that
         stays put while the plane scrolls past it. -->
    <section class="section included">
      <div class="container manifest-grid">
        <div class="section-head manifest-head" data-reveal>
          <p class="eyebrow">Every website</p>
          <h2 class="section-title">What's included, no exceptions</h2>
        </div>

        <div class="manifest-card" data-reveal>
          <ul class="manifest-list" role="list" data-reveal-stagger>
            {included.map((item, i) => (
              <li class="manifest-item" data-reveal>
                <span class="manifest-index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span class="manifest-text">{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="section profiles seam mode-glow">
      <div class="container profiles-grid">
        <div class="section-head profiles-head" data-reveal>
          <p class="eyebrow">Who we build for</p>
          <h2 class="section-title">Five kinds of businesses we know well</h2>
        </div>

        <!-- One focal point, four receding. Five hairline-divided rows of
             equal weight told the reader nothing about where to look; this
             gives the first profile the full slab — bled off the left edge
             of the frame, held in place while the rest scroll past — and
             lets the other four sit beside it as a dense index. -->
        <article id={`profile-${leadProfile.slug}`} class="profile-lead brushed-panel" data-reveal>
          <div class="profile-lead-meta">
            <span class="profile-lead-index" aria-hidden="true">01</span>
            <span class="profile-lead-tag">{leadProfile.star}</span>
          </div>
          <h3 class="profile-lead-name">{leadProfile.title}</h3>
          <p class="profile-lead-body">{leadProfile.body}</p>
          <ul class="profile-lead-benefits" role="list">
            {leadProfile.benefits.map((item) => <li>{item}</li>)}
          </ul>
        </article>

        <div class="profile-minors" data-reveal-stagger>
          {minorProfiles.map((profile, i) => (
            <article id={`profile-${profile.slug}`} class="profile-minor" data-reveal>
              <div class="profile-minor-head">
                <span class="profile-minor-index" aria-hidden="true">{String(i + 2).padStart(2, '0')}</span>
                <h3 class="profile-minor-name">{profile.title}</h3>
                <span class="profile-minor-tag">{profile.star}</span>
              </div>
              <p class="profile-minor-body">{profile.body}</p>
              <ul class="profile-minor-benefits" role="list">
                {profile.benefits.map((item) => <li>{item}</li>)}
              </ul>
            </article>
          ))}
        </div>

        <div class="profiles-fallback" data-reveal>
          <p class="profiles-fallback-text">
            Not one of these five? They're the businesses we see most, not the only ones
            we take on — <a href="#contact">get in touch</a> and we'll tell you honestly
            if we're a fit.
          </p>
        </div>
      </div>
    </section>

    <!-- The screenshots run off the right edge rather than sitting centred
         with a margin on all sides — the subject is never safely contained
         in the frame. -->
    <section class="section device-showcase seam">
      <div class="container showcase-grid">
        <div class="section-head showcase-head" data-reveal>
          <p class="eyebrow">See it for yourself</p>
          <h2 class="section-title">The site you're looking at, on any screen</h2>
        </div>

        <div class="showcase-stage" data-reveal>
          <div class="stage-laptop">
            <DeviceFrame
              device="laptop"
              image="home-laptop.webp"
              alt="The Aex Meridian homepage shown on a laptop screen"
            />
          </div>
          <div class="stage-phone">
            <DeviceFrame
              device="phone"
              image="pricing-phone.webp"
              alt="The Aex Meridian pricing page shown on a phone screen"
            />
          </div>
        </div>
      </div>
    </section>

    <WorkGrid />

    <section class="section founder seam mode-dark-bleed mode-glow" id="founder">
      <div class="container founder-grid">
        <div class="founder-portrait" data-reveal>
          {founderPhotoExists ? (
            <img src="/images/founder.jpg" alt="Caleb Aex, founder of Aex Meridian" class="founder-photo" width="480" height="480" loading="lazy" />
          ) : (
            <div class="founder-monogram" role="img" aria-label="Caleb Aex, founder of Aex Meridian">AM</div>
          )}
        </div>

        <div class="founder-copy" data-reveal>
          <p class="eyebrow">The founder</p>
          <h2 class="founder-name">Caleb Aex, founder</h2>
          <p class="founder-body">
            Aex Meridian is intentionally small — just one person. No account managers,
            no handoffs, no ticket queue. When you call, you get the person who
            actually built your site.
          </p>
          <p class="founder-body">
            That's the whole model. Small roster, direct line, work that gets done
            because there's no one else to hand it to. First response within one
            business day.
          </p>
          <p class="founder-contact">
            <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
            <span aria-hidden="true"> &middot; </span>
            <a href={contactPhoneHref}>{contactPhoneDisplay}</a>
            <span aria-hidden="true"> &middot; </span>
            <a href={contactPhoneSmsHref}>Text</a>
          </p>
        </div>
      </div>
    </section>

    <section class="section ow-cta cta-band">
      <video class="cta-band-video" data-src="/videos/cta-depth.mp4" muted playsinline loop preload="none" aria-hidden="true"></video>
      <div class="container ow-cta-inner cta-band-inner" data-reveal>
        <MeridianRule dot="none" align="left" class="cta-rule" />
        <h2 class="cta-heading">Think we're a fit?</h2>
        <p class="cta-sub">Tell us about your business — we'll tell you honestly if we can help.</p>
        <p class="cta-guarantee">You see it work before you pay a dollar.</p>
        <a href="#contact" class="btn btn-primary btn-shimmer" data-magnetic>
          <span>Get your free demo</span>
          <span class="btn-arrow">&rarr;</span>
        </a>
      </div>
    </section>
    <ContactForm />
  </main>
  <Footer contactHref="#contact" />
</Layout>

<style>
  .hiw-page {
    background-color: var(--color-navy);
    color: var(--color-ivory);

    /* The container's own side padding, restated locally so sections that
       break the frame can cancel exactly the right amount instead of
       guessing. --bleed is the distance from the container's content edge
       out to the viewport edge; any section using it runs off the frame
       rather than stopping at a safe margin. */
    --gutter: clamp(24px, 5vw, 64px);
    --bleed: calc(-1 * (var(--gutter) + max(0px, (100vw - var(--max-width)) / 2)));
    --bleed-pad: calc(var(--gutter) + max(0px, (100vw - var(--max-width)) / 2));
  }

  .hiw-page .eyebrow {
    color: var(--color-steel);
  }

  .section-title {
    color: var(--color-ivory);
  }

  /* ── Opening ───────────────────────────────────────────────────────── */

  .hiw-open {
    padding: var(--space-6) 0 var(--space-7);
  }

  .hiw-open-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.4fr);
    column-gap: clamp(32px, 6vw, 112px);
    align-items: start;
  }

  .hiw-title {
    margin-top: var(--space-2);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.35rem, 5.4vw, 4.5rem);
    line-height: 1.03;
    letter-spacing: -0.03em;
    color: var(--color-ivory);
  }

  .hiw-subhead {
    margin-top: var(--space-3);
    font-size: 17px;
    line-height: 1.7;
    color: var(--color-muted);
    max-width: 48ch;
  }

  .hiw-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .hiw-actions .btn-ghost {
    border-color: rgba(var(--color-ivory-rgb), 0.45);
  }

  .hiw-actions .btn-ghost:hover,
  .hiw-actions .btn-ghost:focus-visible {
    border-color: var(--color-ivory);
    background: rgba(var(--color-ivory-rgb), 0.08);
  }

  /* The five categories as a thin ruled rail, not a row of pills. Pushed
     down past the headline's first lines so the two columns never line up
     at the top — the frame is split, and not evenly. */
  .hiw-ledger {
    margin-top: clamp(20px, 8vw, 118px);
    border-top: 1px solid rgba(var(--color-ivory-rgb), 0.22);
  }

  .hiw-ledger-label {
    margin: 14px 0 6px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-steel);
  }

  .hiw-ledger-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 14px;
    padding: 13px 10px 13px 0;
    border-top: 1px solid rgba(var(--color-ivory-rgb), 0.1);
    text-decoration: none;
    transition: var(--transition-fast);
  }

  .hiw-ledger-row:hover,
  .hiw-ledger-row:focus-visible {
    padding-left: 10px;
    padding-right: 0;
    background: rgba(var(--color-ivory-rgb), 0.05);
  }

  .hiw-ledger-number {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--color-steel);
  }

  .hiw-ledger-name {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-ivory);
  }

  .hiw-ledger-arrow {
    color: rgba(var(--color-ivory-rgb), 0.45);
    transition: transform var(--transition-fast), color var(--transition-fast);
  }

  .hiw-ledger-row:hover .hiw-ledger-arrow,
  .hiw-ledger-row:focus-visible .hiw-ledger-arrow {
    transform: translateX(3px);
    color: var(--color-amber);
  }

  /* ── The sweep ─────────────────────────────────────────────────────── */

  .process {
    padding-bottom: 0;
  }

  /* Undersized on purpose: this heading introduces the stage words, it
     doesn't compete with them. */
  .process-head {
    margin-bottom: clamp(32px, 5vw, 72px);
  }

  .process-head .section-title {
    font-size: var(--text-statement);
  }

  .sweep {
    position: relative;
    z-index: 1;
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .sweep-inner {
    position: relative;
  }

  /* The form itself — a wide, soft, barely-there body of brushed metal,
     and the hot specular edge running down its leading side. Both lean at
     the same angle the stage words step at, so the type and the light are
     describing the same movement rather than decorating each other. */
  .sweep-body {
    position: absolute;
    left: -2%;
    top: 0;
    bottom: 0;
    width: clamp(140px, 18vw, 320px);
    z-index: 0;
    transform: skewX(var(--blade-angle, 26deg));
    transform-origin: top left;
    background: linear-gradient(
      104deg,
      rgba(var(--color-ivory-rgb), 0.075),
      rgba(var(--color-ivory-rgb), 0.012) 58%,
      transparent 82%
    );
    filter: blur(14px);
    pointer-events: none;
  }

  .sweep-edge {
    position: absolute;
    left: -6px;
    top: 0;
    bottom: 0;
    width: 2px;
    z-index: 0;
    transform: skewX(var(--blade-angle, 26deg));
    transform-origin: top left;
    background: linear-gradient(
      180deg,
      rgba(var(--color-ivory-rgb), 0) 0%,
      rgba(var(--color-ivory-rgb), 0.14) 24%,
      rgba(var(--color-ivory-rgb), 0.4) 58%,
      rgba(var(--color-ivory-rgb), 0.95) 100%
    );
    pointer-events: none;
  }

  .sweep-list {
    position: relative;
    z-index: 1;
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(28px, 4.4vw, 72px);
  }

  .sweep-step {
    --sweep-x: clamp(0px, 8vw, 148px);
    display: grid;
    grid-template-columns: minmax(0, auto) minmax(0, 32ch);
    column-gap: clamp(20px, 2.6vw, 44px);
    align-items: end;
    margin-left: calc(var(--i) * var(--sweep-x));
  }

  /* The one hard fact on this page is speed, so the day range gets a
     machined plate of its own rather than being folded into the body copy
     — mono, tracked, silver, with a short rule pointing into the word. */
  .sweep-day {
    grid-column: 1;
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: clamp(8px, 1vw, 16px);
    font-family: var(--font-mono);
    font-size: clamp(12px, 1.05vw, 15px);
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
    color: var(--color-amber);
  }

  .sweep-day::before {
    content: '';
    width: clamp(18px, 2.4vw, 40px);
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-amber));
    flex-shrink: 0;
  }

  .sweep-word {
    grid-column: 1;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.9rem, 9vw, 8.25rem);
    line-height: 0.86;
    letter-spacing: -0.045em;
    color: var(--color-ivory);
  }

  /* Light arriving stage by stage: the work comes out of the dark and is
     fully lit only at delivery. Every step still clears AA at large-text
     size; the dimmest is ~4.5:1 on the page background. */
  .sweep-step:nth-child(1) .sweep-word {
    color: color-mix(in srgb, var(--color-ivory) 48%, var(--color-navy));
  }

  .sweep-step:nth-child(2) .sweep-word {
    color: color-mix(in srgb, var(--color-ivory) 66%, var(--color-navy));
  }

  .sweep-step:nth-child(3) .sweep-word {
    color: color-mix(in srgb, var(--color-ivory) 84%, var(--color-navy));
  }

  .sweep-desc {
    grid-column: 2;
    grid-row: 2;
    align-self: end;
    padding-bottom: 0.3em;
    font-size: clamp(14px, 1.05vw, 15.5px);
    line-height: 1.65;
    color: var(--color-muted);
  }

  /* Where the form lands. The brightest point sits off-centre, at roughly
     the x the leaning edge arrives at — the convergence in the reference
     photograph, not a centred divider. */
  .sweep-horizon {
    position: relative;
    height: 1px;
    margin: clamp(48px, 6vw, 96px) calc(-1 * var(--gutter)) 0;
    background: linear-gradient(
      90deg,
      transparent 1%,
      rgba(var(--color-ivory-rgb), 0.85) 34%,
      rgba(var(--color-ivory-rgb), 0.32) 70%,
      transparent
    );
  }

  .sweep-horizon::after {
    content: '';
    position: absolute;
    left: 34%;
    top: 50%;
    width: min(760px, 72%);
    height: 94px;
    transform: translate(-50%, -50%);
    background: radial-gradient(
      ellipse 50% 100% at 50% 50%,
      rgba(var(--color-ivory-rgb), 0.16),
      transparent 72%
    );
    filter: blur(12px);
    pointer-events: none;
  }

  /* The mirror floor as light pooling under the horizon, not a literal
     flipped copy of the type — the reflection proper belongs to one page
     on this site and it isn't this one. */
  .sweep-floor {
