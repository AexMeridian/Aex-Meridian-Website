    background: linear-gradient(135deg, var(--color-teal) 0%, var(--color-navy) 130%);
  }

  .profile-visual--steel {
    background: linear-gradient(135deg, var(--color-steel) 0%, var(--color-navy) 130%);
  }

  .profile-visual--amber {
    background: linear-gradient(135deg, #C9A46B 0%, var(--color-navy) 130%);
  }

  .profile-icon-badge {
    position: relative;
    z-index: 1;
    display: inline-flex;
