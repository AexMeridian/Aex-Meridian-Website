---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Guarantee from '../components/Guarantee.astro';
import PastWork from '../components/PastWork.astro';
import HowItWorks from '../components/HowItWorks.astro';
import WhyNotJust from '../components/WhyNotJust.astro';
import ContentServices from '../components/ContentServices.astro';
import LiveDemo from '../components/LiveDemo.astro';
import FounderNote from '../components/FounderNote.astro';
import FinalCTA from '../components/FinalCTA.astro';
import ContactForm from '../components/ContactForm.astro';
---

<Layout>
  <Header />
  <main id="main-content">
    <Hero />
    <Guarantee />
    <ContentServices />
    <LiveDemo />
    <PastWork />
    <HowItWorks />
    <WhyNotJust />
    <FounderNote />
    <FinalCTA />
    <ContactForm />
  </main>
  <Footer />
</Layout>
